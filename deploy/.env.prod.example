# 生产环境变量模板。复制为deploy/.env.prod（不入库），逐项替换 REPLACE_…。
# 渲染：AIGC_ENV=prod deploy/docker/render-etc.sh   → 输出 deploy/docker/etc-prod（含密钥，不入库）
# 启动：docker compose -f deploy/docker-compose.yml up -d

# ---- 数据库：Java 栈的 fusion_aigc（共享库），口令必须与 Java 的 MYSQL_PASSWORD 一致
MYSQL_HOST=REPLACE_MYSQL_HOST
MYSQL_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ---- Redis：与 Java 共用的会话库。Java 线上 REDIS_DB 已确认为 10，两边必须一致
REDIS_HOST=REPLACE_REDIS_HOST
REDIS_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
GATEWAY_REDIS_DB=10

# ---- 密钥：各自用 openssl rand -hex 32 生成，两个不能相同
JWT_SECRET=REPLACE_WITH_RANDOM_HEX_64
ADMIN_JWT_SECRET=REPLACE_WITH_RANDOM_HEX_64

# ---- 外部服务：全部必须是真实地址（不能是 mock 或 127.0.0.1）
AIGC_ENDPOINT=REPLACE_AIGC_EXECUTOR_URL
UNION_BASE_URL=REPLACE_UNION_AGENT_URL
LINK_PARSE_URL=REPLACE_LINK_PARSE_URL
GATEWAY_FILES_BASE=REPLACE_GATEWAY_FILES_BASE

# ---- 执行面 task_id 前缀：生成 <前缀>_<32位hex>，只能字母数字，不含下划线
TASK_ID_PREFIX=AiCreationLife

# ---- 对外端口：只绑回环，公网入口由反向代理接入
GATEWAY_PUBLISH_ADDR=127.0.0.1
GATEWAY_PUBLISH_PORT=18100
ADMIN_PUBLISH_ADDR=127.0.0.1
ADMIN_PUBLISH_PORT=18101
