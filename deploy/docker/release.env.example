# 发布凭据（本机私有，不入库）。Makefile_x 用 -include 读这份文件，等价于 export 同名变量。
#
#   cp deploy/docker/release.env.example deploy/docker/release.env
#   chmod 600 deploy/docker/release.env && vi deploy/docker/release.env
#
# ⚠️ 不要把真实值填回本文件（.example 是入库模板），也不要用 make 命令行传口令
#    （会进 shell history 与进程列表）。要临时覆盖就 export，别改仓库里的默认值。

# 私有仓库口令（make -f Makefile_x login / push-all 用）
REGISTRY_PASS=

# 部署 webhook（make -f Makefile_x deploy / deploy-media 用）。两者缺一，目标会直接报错退出。
HOOK_URL=
HOOK_KEY=

# ---- studio 相关变量不在本文件 ----
# 本文件只放发布凭据（仓库口令 / webhook），不要把业务密钥写进来。studio 的运行时变量写在服务器上的 .env（模板 deploy/server/deploy.env.example）：
#   STUDIO_PORT          studio-rpc 端口（默认 19205）
#   AI_GATEWAY_URL / AI_GATEWAY_KEY_ID / AI_GATEWAY_SECRET   ai-gateway 地址与调用方 fusion-go 的 HMAC 凭据（留空 = studio 提交返回「暂未开放」）
#   REVERSE_SIDECAR_URL / REVERSE_IMAGE / REVERSE_PORT        反推 sidecar 地址、镜像、端口
#   REVERSE_AIG_SECRET / REVERSE_AIG_KEY_ID / REVERSE_AIG_BASE_URL / REVERSE_MODEL_GROUP / REVERSE_ALLOWED_DEPLOYMENTS
#                        反推 sidecar 经 ai-gateway 调 DeepSeek 的调用方 prompt-reverse 凭据；只注入 sidecar 容器，不进镜像、不进 etc/
