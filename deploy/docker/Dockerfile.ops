# aigc-local-life ops 镜像 —— 本机架构原生构建版（不带下划线）。
#
# 与 _Dockerfile.ops 成对，唯一差别在构建阶段：
#   本文件（不带线）：FROM golang:alpine 原生构建，GOOS=linux 不指定 GOARCH → 产物为本机架构，本地调试用。
#   _Dockerfile.ops（带线）：FROM --platform=$BUILDPLATFORM + GOARCH=amd64 跨编译 → 推私有仓库部署用。
# 两版的运行时 stage、MySQL 客户端、非 root 用户完全一致。
#
# 数据库客户端必须是官方 MySQL 8：RDS 账号默认用 caching_sha2_password，
# MariaDB 客户端（alpine 的 mariadb-client）不带该插件。官方客户端是 glibc 二进制，
# 所以运行时用 debian 而不是 alpine（musl 跑不了）。
#
# 用法（本地原生构建）：
#   docker buildx build --load -f deploy/docker/Dockerfile.ops \
#     -t aigc-local-life-ops:dev .
#
# 部署时由 compose 调用：command: ["bash", "/app/pkg/install.sh", "prepare"]
ARG GO_VERSION=1.27.3

# ---------- Stage 1：本机架构原生构建（只编运维工具）----------
FROM golang:${GO_VERSION}-alpine AS build
WORKDIR /src
ARG GOPROXY=https://goproxy.cn,direct
ENV GOPROXY=${GOPROXY}
RUN apk add --no-cache git
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod set -eux; mkdir -p /out; \
    for t in mkconf billing-check seed; do \
      CGO_ENABLED=0 GOOS=linux go build -tags timetzdata -trimpath -ldflags '-s -w' \
        -o "/out/$t" "./tools/ops/$t"; \
    done

# ---------- Stage 1b：官方 MySQL 客户端来源（只取客户端，不取 server） ----------
FROM mysql:8.0 AS mysqlcli

# ---------- Stage 2：最小运行时（与 _Dockerfile.ops 一致）----------
FROM debian:bookworm-slim
# bash：install.sh / migrate.sh 是 bash 脚本；curl：健康检查；jq：音色试听脚本
# 下面几个是官方 mysql 客户端的链接依赖（ldd 实测）：libncurses6 / libtinfo6 / libssl3 / libstdc++6
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates tzdata bash curl jq \
      libncurses6 libtinfo6 libssl3 libstdc++6 \
 && rm -rf /var/lib/apt/lists/*
ENV TZ=Asia/Shanghai
COPY --from=mysqlcli /usr/bin/mysql /usr/local/bin/mysql
COPY --from=mysqlcli /usr/bin/mysqladmin /usr/local/bin/mysqladmin
COPY --from=mysqlcli /usr/bin/mysqldump /usr/local/bin/mysqldump
WORKDIR /app
COPY --from=build /out/ /app/pkg/bin/
COPY deploy/etc/ /app/pkg/etc-dev/
COPY deploy/sql/Go_V*.sql /app/pkg/sql/
COPY deploy/server/install.sh deploy/server/migrate.sh /app/pkg/
COPY deploy/server/nginx/ /app/pkg/nginx/
COPY deploy/scripts/gen-voice-previews.sh /app/pkg/scripts/
ARG VERSION=dev
# 客户端能跑起来才算合格；caching_sha2_password 能不能过由部署时连 RDS 验证
RUN echo "$VERSION" > /app/pkg/VERSION \
 && mkdir -p /app/etc /app/nginx /app/backup /app/logs \
 && mysql --version && mysqldump --version && jq --version \
 && groupadd --system --gid 10001 app \
 && useradd --system --uid 10001 --gid 10001 --home-dir /app --shell /usr/sbin/nologin app \
 && chown -R app:app /app/etc /app/logs
USER app
