# aigc-local-life 单服务镜像：一个镜像只装一个服务二进制，配置在运行时挂载到 /app/etc（由 prepare 生成）。
# 多阶段构建、跨编译 linux/amd64、最小运行时、非 root 运行。
# 运行时用 alpine：静态二进制 + ca-certificates 约 13MB，比 debian-slim 省 80MB+；
# 保留 curl（api 健康检查）与 bash（rpc 健康检查用 </dev/tcp 探端口），与现有 compose 的健康检查写法一致。
#
# 用法（Makefile_x 的对应目标已封装，一般不用手敲）：
#   docker buildx build --builder orbstack --platform linux/amd64 --provenance=false \
#     --build-arg SERVICE=copywriting/rpc --build-arg BIN=copywriting-rpc \
#     -t <仓库>/aigc-local-life-copywriting-rpc:<tag> -f deploy/docker/_Dockerfile.svc --load .
#
# SERVICE：app/ 下的服务目录，如 copywriting/rpc、gateway/api
# BIN：产物二进制名，同时决定默认配置文件名 <BIN>.yaml
# 固定到补丁版本（与本机工具链一致），避免上游发补丁时同一 tag 产出不同二进制
ARG GO_VERSION=1.27.2

# ---------- Stage 1：跨编译 linux/amd64 ----------
# 构建镜像用 alpine（~250MB，比 bookworm 拉取快）；本项目 go.mod 没有 replace 本地路径，alpine 完全够用
FROM --platform=$BUILDPLATFORM golang:${GO_VERSION}-alpine AS build
WORKDIR /src
# 模块代理：容器里默认的 proxy.golang.org 国内拉不动，走 goproxy.cn（可 --build-arg GOPROXY=... 覆盖）
ARG GOPROXY=https://goproxy.cn,direct
ENV GOPROXY=${GOPROXY}
RUN apk add --no-cache git
COPY go.mod go.sum ./
# 模块缓存挂在 buildkit cache 里：go.mod 不变就不必重新下载，改了也只是增量下载
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY . .
ARG SERVICE
ARG BIN
# 借 ENV 把构建参数暴露给 RUN 的 shell（ARG 本身不进 RUN 环境）。
# 强制 GOARCH=amd64：构建容器跑在主机架构上（Apple 芯片是 arm64），
# 不指定的话即使 buildx 传了 --platform linux/amd64，产物也是 aarch64，容器起不来。
ENV SVC_DIR=${SERVICE} APP_BIN=${BIN}
RUN --mount=type=cache,target=/go/pkg/mod CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -tags timetzdata -trimpath -ldflags '-s -w' -o /out/$APP_BIN ./app/$SVC_DIR

# ---------- Stage 2：最小运行时 ----------
FROM alpine:3.20
# ca-certificates：调外部 HTTPS 接口；curl：api 健康检查；bash：rpc 健康检查探端口（</dev/tcp）
# 时区已用 -tags timetzdata 内嵌进二进制，这里装一份给读 /usr/share/zoneinfo 的代码兜底
RUN apk add --no-cache ca-certificates tzdata curl bash
ENV TZ=Asia/Shanghai
WORKDIR /app
ARG BIN
COPY --from=build /out/${BIN} /app/${BIN}
RUN addgroup -g 10001 -S appgroup \
 && adduser -u 10001 -S -G appgroup -h /app -s /sbin/nologin -H appuser \
 && printf '#!/bin/sh\n# 统一入口：用 ENV 里的服务名拼出二进制与配置路径。\n# 写成脚本 + ENTRYPOINT 用 JSON 形式，既能让 buildkit 满意（免掉 JSONArgsRecommended 提示），\n# 里面的 exec 也保证服务进程顶替 shell 成为主进程，SIGTERM 直达、优雅退出生效。\nexec "/app/$APP_BIN" -f "/app/etc/$APP_BIN.yaml"\n' > /app/entrypoint.sh \
 && chmod +x /app/entrypoint.sh \
 && chown -R appuser:appgroup /app
ENV APP_BIN=${BIN}
USER appuser
# 端口由配置里的 ListenOn 决定（rpc 19201–19204，api 18888/18889），部署时用 command 覆盖
ENTRYPOINT ["/app/entrypoint.sh"]