# aigc-local-life 容器部署配置。复制为同目录的 .env（chmod 600，不入库），按实际填写后 docker compose up -d。
# 变量名与一键脚本的 deploy.env 一致；docker compose 用它做变量替换，prepare 服务也从它读取全部配置。
# 正式环境的校验规则与一键脚本相同：token 鉴权、计费开启、执行面 / 域名 / 会话 Redis 必填，不满足 prepare 直接失败。
#
# ⚠️ 值里有 $ 的（RDS / Redis 口令、各类密钥常见）必须用单引号包住，例如 DB_PASS='ab$cd'：
#    docker compose 会把 $xxx 当成变量替换，口令被悄悄改掉，表现为连不上。

# ---------- 镜像 ----------
# 单镜像方式（docker-compose.yml）：一个镜像装全部服务，由主 Makefile 的 make image 构建推送
# 镜像仓库地址与版本。正式环境建议带 digest（…/aigc-local-life:v1.0.0@sha256:…），回滚就是换回上一版。
AIGC_IMAGE=
# 每服务独立镜像方式（docker-compose.registry.yml + Makefile_x）改用下面两项：
# AIGC_REGISTRY 填仓库地址（含端口），AIGC_TAG 填版本号，一个 TAG 覆盖 6 个服务镜像与 ops 镜像，回滚 = 换回上一个 TAG
# AIGC_REGISTRY=uniontest.pengqiwl.com:5000
# AIGC_TAG=v1.0.0
COMPOSE_PROJECT_NAME=aigc-local-life
# 每个服务的内存上限
AIGC_MEM_LIMIT=1g

# ---------- 数据库：阿里云 RDS（fusion_aigc 库，与 Java 共用）----------
# 填 RDS 的内网地址；服务器 IP 要在 RDS 白名单里
DB_HOST=
DB_PORT=3306
DB_NAME=fusion_aigc
DB_USER=
DB_PASS=
# mysql / mysqldump 的额外连接参数。RDS 账号是 MySQL 8 默认的 caching_sha2_password：
#   连不上时报 "Plugin caching_sha2_password could not be loaded" 或提示取公钥时，
#   填 --ssl（走 TLS，最稳）或 --get-server-public-key
MYSQL_OPTS=

# ---------- 端口（全部只监听 127.0.0.1，不要在安全组放行；公网只经宿主机 nginx）----------
GATEWAY_PORT=18888
ADMIN_PORT=18889
COPYWRITING_PORT=19201
DIGITALHUMAN_PORT=19202
NOTE_PORT=19203
IMAGEGEN_PORT=19204
STUDIO_PORT=19205
ASSETLIB_PORT=19206
CANVAS_PORT=19207

# ---------- 公网入口（宿主机 nginx 加载 ./nginx/aigc-local-life.conf）----------
PUBLIC_DOMAIN=aigc.pengqiwl.com
# Java 服务地址：nginx 把 /api/v1/local-life 以外的 /api/v1/ 接口（登录、点数、素材、刷新令牌等）转给它
JAVA_UPSTREAM=127.0.0.1:18080

# ---------- 与 Java 同源的配置 ----------
# 宿主机上 Java 服务的 .env 绝对路径（只读挂载进 prepare，必须是已存在的文件）：AIGC_BASE_URL 与会话参数从这里读，保证两边同一个值。
# 下面对应的变量显式填写时以显式的为准。
JAVA_ENV_FILE=
# 执行面地址，与 Java 的 AIGC_BASE_URL 相同；留空则从 JAVA_ENV_FILE 读
AIGC_ENDPOINT=

# ---------- 登录会话：与 Java 共用（正式环境必填）----------
# 会话 Redis 默认从 JAVA_ENV_FILE 读（REDIS_HOST / REDIS_PORT / REDIS_PASSWORD / REDIS_DB，与 Java 完全一致）。
# 只在要覆盖时才填；库号与 Java 不一致安装会报错。Java 的 REDIS_HOST 若是容器服务名（如 redis），宿主机解析不到，必须在这里填 SESSION_REDIS_ADDR。
SESSION_REDIS_ADDR=
SESSION_REDIS_PASS=
SESSION_REDIS_DB=
# 留空 = 读 JAVA_ENV_FILE（APP_SECURITY_TOKEN_MAX_CONCURRENT_SESSIONS / TOKEN_ACCESS_HOURS / TOKEN_REFRESH_DAYS），读不到用 0 / 2 / 7
SESSION_MAX_CONCURRENT=
TOKEN_ACCESS_HOURS=
TOKEN_REFRESH_DAYS=

# 生成：openssl rand -hex 32（两个各生成一次，不能相同）

# ---------- 登录（联盟临时 token → 本服务令牌）----------
# 留空时登录接口返回「暂未开放」（App 登录不了）
UNION_BASE_URL=https://xxlp-app.pengqiwl.com

# ---------- 鉴权 / 计费 / 接口文档（正式版只接受下面这组值）----------
AUTH_MODE=token
BILLING_MODE=on
SWAGGER_ENABLED=0

# ---------- 其他 ----------
# 执行面 task_id 前缀，生成 <前缀>_<32位hex>。只能字母数字
TASK_ID_PREFIX=AiCreationLife
# 分享链接解析（爆款视频复刻的链接入口）；留空则只能上传视频
LINK_PARSE_URL=http://101.37.203.33:8000

# ---------- 共享媒体服务 aigc-media（封面 / 水印 / 合成 / 抽帧）----------
# 由 **Java 栈**编排（fusion-aigc 的 compose 里有 media-svc 与 r-nacos），本栈只是调用方，两边都是 host 网络。
# token 留空则从 JAVA_ENV_FILE 里 Java 的 MEDIA_SERVICE_TOKEN 读（推荐：单一真相源）。两边都空时 prepare 直接失败——
# 因为配错的表现是「封面静默消失」而不是报错，很难事后归因。
MEDIA_SVC_TOKEN=
# 静态地址：注册中心不可用时的回退（也是没配注册中心时的唯一入口）
MEDIA_SVC_BASE_URL=http://127.0.0.1:18090
# 注册中心（r-nacos）地址：填了就按服务名 aigc-media 订阅实例；留空则只用上面的静态地址
MEDIA_NACOS_ADDR=127.0.0.1:8848
# r-nacos 开了 OpenAPI 鉴权（RNACOS_ENABLE_OPEN_API_AUTH=true）时必须与 Java 栈同账号，否则订阅/注册都会被拒
MEDIA_NACOS_USERNAME=
MEDIA_NACOS_PASSWORD=
# 新用户建档交给 Java 的 /api/v1/union/user-register；留空由本服务自己写表
FUSION_BASE_URL=
FUSION_APP_KEY=
FUSION_APP_SECRET=
FUSION_KEY_VERSION=
# 迁移前整库备份到 ./backup/（RDS 大库耗时长，也可以改用 RDS 自带的备份）。首次上线建议设 1
BACKUP_BEFORE_MIGRATE=0

# ---------- studio（商拍换装 / 姿态复刻 / 图片生成）----------
# ai-gateway 地址与调用方凭据（ai-gateway 侧登记 caller_id=fusion-go）。AI_GATEWAY_URL 留空 = studio 提交返回「暂未开放」
AI_GATEWAY_URL=
AI_GATEWAY_KEY_ID=fusion-go-v1
# 必须与 ai-gateway 侧 AIG_CALLER_GO_SECRET 完全一致，否则 studio / 画布每次提交 401。可用 deploy/scripts/gen-gateway-callers.sh 一次生成两边
AI_GATEWAY_SECRET=
# 反推 sidecar 地址；留空用默认 http://127.0.0.1:8090（REVERSE_BASE_URL 是同义别名）
REVERSE_SIDECAR_URL=
# 参考图驱动的自动校色求解服务（tools/colorfix-solver，Python）：地址留空 = 功能关闭（前端隐藏「自动校色」，接口回 7003 · COLORFIX_AUTO_DISABLED）。
# token 须与求解服务的 COLORFIX_TOKEN 一致（>= 16 位）。求解服务自己下载成品 / 参考图 / 蒙版：它的 COLORFIX_FETCH_ALLOW_HOSTS 要放行 OSS / CDN 域名（成品私有桶签名地址、素材库公有桶、本服务存储），
# 或在集群内网用 COLORFIX_ALLOW_PRIVATE_FETCH=1（只在内网部署时开）
COLORFIX_SOLVER_URL=
COLORFIX_SOLVER_TOKEN=
# colorfix-solver 容器（profile colorfix）：镜像留空取 aigc-colorfix-solver:latest（registry 版取 ${AIGC_REGISTRY}/aigc-local-life-colorfix-solver:${AIGC_TAG}）；端口只绑 127.0.0.1
COLORFIX_IMAGE=
COLORFIX_PORT=18095
# 求解端允许下载的域名（逗号分隔，必填：成品私有桶 / 素材库公有桶 / 本服务存储的域名）；COLORFIX_ALLOW_PRIVATE_FETCH 仅内网部署且 OSS 走内网地址时才开（填 1）
COLORFIX_FETCH_ALLOW_HOSTS=
COLORFIX_ALLOW_PRIVATE_FETCH=
COLORFIX_MAX_CONCURRENT=4
# studio / 素材库额外允许的图片地址（逗号分隔）：素材库公有桶 / CDN。
# 可只写域名（缺协议按 https），如 cdn.example.com；要限定目录就写域名+路径，如 assets.example.com/library/（按路径段匹配）。
# 也可写完整前缀 https://cdn.example.com/ 。协议须与图片地址一致；留空 = 只认本服务签发的地址。
STUDIO_INPUT_URL_PREFIXES=
# 免费档图片读时参数水印（studio + assetlib + canvas），与 Java 同名同值：开关 true / false；处理串必须与 Java 启动日志
# check=free_watermark.process 的值逐字相同（留空 = mrw:// 输出为空，失败关闭）
FREE_WATERMARK_ENABLED=
FREE_WATERMARK_OSS_PROCESS=

# ---------- 反推 sidecar（prompt-reverse 容器）----------
# 网关地址：留空复用 AI_GATEWAY_URL
REVERSE_AIG_BASE_URL=
REVERSE_AIG_KEY_ID=prompt-reverse-v1
# 必须与 ai-gateway 侧 AIG_CALLER_REVERSE_SECRET 完全一致（且不同于 fusion-go 的 secret）；留空 = sidecar llm_configured=false，读图 502
# 注意：prepare 容器经 env_file 也会加载整个 .env，因此它能读到此值（不会写进 etc/）
REVERSE_AIG_SECRET=
REVERSE_MODEL_GROUP=vlm.deepseek-flash
# 排障钉渠道（可选，逗号分隔），平时留空
REVERSE_ALLOWED_DEPLOYMENTS=
# 长轮询秒数（1–60）
REVERSE_AIG_WAIT_S=25
# sidecar 镜像：**留空**，与其它服务一样取 ${AIGC_REGISTRY}/aigc-local-life-prompt-reverse:${AIGC_TAG}。
# 只有要换成本地镜像时才填，且必须是完整引用（仓库/名称:标签），不能只写版本号（只写 1.2 会被当成 Docker Hub 镜像拉取）。
REVERSE_IMAGE=
# 监听端口（只绑 127.0.0.1）
REVERSE_PORT=8090

# ---------- canvas（画布 + 提示词库）----------
# 画布复用上面的 AI_GATEWAY_*、MEDIA_SVC_*，试穿经 studio-rpc。
# Java 主项目的**内网**地址（不经 nginx）：放大 / 扩图 / 局部重绘调 Java 兼容工具。一般 http://127.0.0.1:18080；留空 = 这三个工具返回「暂未开放」
CANVAS_JAVA_BASE_URL=

# ---------- 画布助手内部入口（Java 智能体 → 网关 /internal/v1/canvas/agent/*）----------
# 与 Java 的 APP_FUSION_GO_KEY_ID / APP_FUSION_GO_SECRET 必须一致。secret 至少 32 字节，生成：openssl rand -hex 32
# 两项都留空 = 不注册内部入口，画布工具不进智能体规划目录。一经使用不要改（改了 Java 与网关要同时更新）。
# 需要 ops 镜像带 -canvas-internal-* 支持的版本（prepare 据此生成网关 CanvasInternal.Keys）。
CANVAS_INTERNAL_KEY_ID=
CANVAS_INTERNAL_SECRET=
