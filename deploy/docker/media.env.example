# 媒体服务部署变量。复制为 media.env 后填写，chmod 600。
# 镜像：正式环境建议带 digest（…@sha256:…）
AIGC_MEDIA_IMAGE=registry.example.com/aigc-media:v1.0.0
# 与 Java（app.media-service.token / MEDIA_SERVICE_TOKEN）和 Go（imagegen 的 VideoRemake.MediaSvc.Token）完全一致
MEDIA_SERVICE_TOKEN=change-me-to-a-long-random-string
# 默认 127.0.0.1:18090；改成别的地址需同步改调用方的 MEDIA_SERVICE_BASE_URL
MEDIA_LISTEN=127.0.0.1:18090
# 注册中心 r-nacos 的 HTTP 地址（host:port，gRPC 端口自动为 +1000）。填了则启动后自注册，调用方自动发现本实例；留空则不注册
MEDIA_NACOS_SERVER_ADDR=
# 调用方访问本实例的地址（注册到注册中心的值）。多实例时每台机器填自己的内网地址
MEDIA_ADVERTISE_URL=http://127.0.0.1:18090
# 水印 logo 文件（宿主机路径），不需要水印可以不填
MEDIA_LOGO_FILE=./logo.png
MEDIA_MEM_LIMIT=2g
# 默认 false。只有本地 e2e 才设 true（素材在内网对象存储时）
MEDIA_ALLOW_PRIVATE_HOSTS=false
