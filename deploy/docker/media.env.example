# 媒体服务部署变量。复制为 media.env 后填写，chmod 600。
# 镜像：正式环境建议带 digest（…@sha256:…）
AIGC_MEDIA_IMAGE=registry.example.com/aigc-media:v1.0.0
# 与 Java（app.media-service.token / MEDIA_SERVICE_TOKEN）和 Go（imagegen 的 VideoRemake.MediaSvc.Token）完全一致
# 必填（不能留空或用占位符）。生成：openssl rand -hex 32
MEDIA_SERVICE_TOKEN=
# 本实例稳定 ID：6 位小写字母或数字，首次部署时生成（如 openssl rand -hex 3 取前 6 位），之后不要改，不能与同网段其它实例重复
MEDIA_INSTANCE_ID=
# 资源 ID 与对象键的 HMAC 密钥：至少 32 字节（openssl rand -hex 32）。丢失则已有资源的对象键无法重算，必须备份
MEDIA_IDENTITY_SECRET=
# 默认 127.0.0.1:18090；改成别的地址需同步改调用方的 MEDIA_SERVICE_BASE_URL
MEDIA_LISTEN=127.0.0.1:18090
# 注册中心 r-nacos 的 HTTP 地址（host:port，gRPC 端口自动为 +1000）。填了则启动后自注册，调用方自动发现本实例；留空则不注册
# 同 compose 内置 r-nacos 时填 127.0.0.1:8848；跨 compose / 多机填宿主内网 IP:8848
MEDIA_NACOS_SERVER_ADDR=127.0.0.1:8848
# 命名空间，留空 = public
MEDIA_NACOS_NAMESPACE=
# r-nacos OpenAPI 鉴权账号：本文件里 r-nacos 的初始化管理员直接复用这两个值（单一来源），
# 所以 compose 内置 r-nacos 时必须填，否则鉴权开着却登录不上，media-svc 注册被拒。
# 跨 compose 复用已有 r-nacos 时，填那台注册中心的管理员账号即可。
MEDIA_NACOS_USERNAME=admin
MEDIA_NACOS_PASSWORD=
# 调用方访问本实例的地址（注册到注册中心的值）。多实例时每台机器填自己的内网地址
MEDIA_ADVERTISE_URL=
# 水印 logo 文件（宿主机路径），不需要水印可以不填
MEDIA_LOGO_FILE=./logo.png
MEDIA_MEM_LIMIT=2g
# 默认 false。只有本地 e2e 才设 true（素材在内网对象存储时）
MEDIA_ALLOW_PRIVATE_HOSTS=false

# ---- 幂等记录存储 ----
# 默认 redis（多实例共享，同一 Idempotency-Key 不会在两台机器上各执行一次）；memory 仅单机开发
MEDIA_IDEMPOTENCY_STORE=redis
# Store=redis 时必填（host:port），未填服务拒绝启动；运行中不可达时写请求返回 503，不降级
MEDIA_REDIS_ADDR=
MEDIA_REDIS_PASSWORD=

# ---- r-nacos 服务（docker-compose.media.yml 内，镜像 qingpan/rnacos:v0.8.7-alpine，与 Java 母本同版本）----
# 初始化管理员账号 = 上面的 MEDIA_NACOS_USERNAME / MEDIA_NACOS_PASSWORD（compose 里直接复用，不另设变量）
# r-nacos 数据持久化目录（容器 /io）
MEDIA_RNACOS_DATA=./rnacos_data
RNACOS_MEM_LIMIT=512m

# ---- 对象存储（OSS）----
# 线上必须为 true；false 时落到容器内本地目录（只用于开发）
MEDIA_OSS_ENABLED=false
# 签名地址有效期（分钟，上限 1440）
MEDIA_OSS_PRESIGN_MINUTES=60
# 输入体积与超时：大视频下载慢，默认已上调。超时单位为秒，必须小于 Java 调用方（app.media-service.timeout-seconds）的超时
# 运维定位接口（对象键与桶）的令牌，与业务令牌分开；留空则不开放该接口
# 允许接收调用方请求头（如 Authorization）的素材主机，逗号分隔，只列素材站自己的主机；留空则拒绝带 headers 的 ingest
MEDIA_INGEST_HEADER_HOSTS=
MEDIA_OPS_TOKEN=
MEDIA_MAX_INPUT_BYTES=1073741824
# 我方产物字节上传（purpose 非 user_input）的体积上限，默认 2 GiB，与 Java 的 GATEWAY_RESULT_MAX_BYTES 对齐
MEDIA_STORE_LOCAL_MAX_BYTES=2147483648
MEDIA_FETCH_TIMEOUT_SECONDS=1800
MEDIA_OP_TIMEOUT_SECONDS=1800
# 私有桶（user_input、intermediate）：Endpoint 形如 https://oss-cn-shanghai.aliyuncs.com
MEDIA_OSS_PRIVATE_ENDPOINT=
MEDIA_OSS_PRIVATE_BUCKET=
MEDIA_OSS_PRIVATE_ACCESS_KEY=
MEDIA_OSS_PRIVATE_SECRET_KEY=
# 素材库桶（asset_library）：公有读取；CUSTOM_DOMAIN 可选，填了则公有地址用它
MEDIA_OSS_ASSET_ENDPOINT=
MEDIA_OSS_ASSET_BUCKET=
MEDIA_OSS_ASSET_ACCESS_KEY=
MEDIA_OSS_ASSET_SECRET_KEY=
MEDIA_OSS_ASSET_CUSTOM_DOMAIN=
# 第三方交付桶（third_party）：可以和素材库配成同一个桶
MEDIA_OSS_THIRD_ENDPOINT=
MEDIA_OSS_THIRD_BUCKET=
MEDIA_OSS_THIRD_ACCESS_KEY=
MEDIA_OSS_THIRD_SECRET_KEY=
