# 媒体服务镜像 —— 本机架构原生构建版（不带下划线）。
#
# 与 _Dockerfile.media 成对，唯一差别在 Go 构建阶段：
#   本文件（不带线）：FROM golang:bookworm 原生构建，GOOS/GOARCH 用本机架构 → 供本地 build 调试。
#   _Dockerfile.media（带线）：FROM --platform=$BUILDPLATFORM + TARGETOS/TARGETARCH 跨编译 → 推私有仓库部署。
# ffmpeg 基础镜像两版共用（私有仓库预置，见 make -f Makefile_x ffmpeg-base）。
#
#   docker buildx build --load -f deploy/docker/Dockerfile.media \
#     -t aigc-media:dev .
#   运行与配置见 docker-compose.media.yml、media.env.example；契约见 docs/api/media-service.md
#
# 注意：本机架构构建要求 FFMPEG_BASE_IMAGE 也有对应架构的 manifest（Mac arm64 需基础镜像含 arm64，
# 见 Dockerfile.ffmpeg-base 的多架构构建）；跨编译版无此限制。可用 --build-arg FFMPEG_BASE_IMAGE=... 覆盖。
ARG GO_VERSION=1.27.3
ARG FFMPEG_VERSION=9.0.2
ARG FFMPEG_BASE_IMAGE=uniontest.pengqiwl.com:5000/aigc-base/static-ffmpeg

FROM ${FFMPEG_BASE_IMAGE}:${FFMPEG_VERSION} AS ffmpeg

# 编译阶段用本机架构原生构建（与 _Dockerfile.media 的跨编译版唯一差别）
FROM golang:${GO_VERSION}-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
# 只拷编译需要的源码
COPY app/ app/
COPY pkg/ pkg/
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -trimpath -ldflags '-s -w' -o /out/media ./app/media/cmd

# 运行时沿用预置基础镜像（运行库 / 中文字体 / ffmpeg / ffprobe 都在其中）
FROM ffmpeg
ENV MEDIA_LISTEN=127.0.0.1:18090 \
    MEDIA_LOGO_PATH=/app/logo.png
RUN groupadd --system --gid 10001 app \
 && useradd --system --uid 10001 --gid 10001 --home-dir /app --shell /usr/sbin/nologin app
WORKDIR /app
COPY --from=build /out/media /app/media
# 服务启动时会在 /app 下建 ./data（本地存储目录）：目录交给运行用户，否则 mkdir 权限被拒
RUN mkdir -p /app/data && chown -R app:app /app
COPY deploy/docker/media/media-svc.yaml /app/etc/media-svc.yaml
USER app
# 容器探活只看进程（/healthz）；负载均衡 / k8s readinessProbe 用 /readyz（对象存储可达 + 幂等 Redis），
# 不要把 /readyz 当 livenessProbe：对象存储抖动会让实例被反复重启。
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=6 \
  CMD curl -fsS "http://${MEDIA_LISTEN}/healthz" >/dev/null || exit 1
ENTRYPOINT ["/app/media"]
CMD ["-f", "/app/etc/media-svc.yaml"]
