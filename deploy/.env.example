# 本地/单机的 compose 变量（复制为 .env，不入库）。render-etc.sh 与 docker compose 都读它。
#
# 共享的 Java 栈：mysql、redis 与下面的网络都来自 fusion-aigc 的中间件/编排（项目名 fusion）。
# 库表用的是 Java 那边的 fusion_aigc（与 Java 共享，不是独立库）。
MYSQL_HOST=mysql
MYSQL_PASSWORD=123456
REDIS_HOST=redis
REDIS_PASSWORD=123456
# 必须与 Java 服务的 REDIS_DB 一致（gateway-api 的 Session 与 Java 共用 token）
GATEWAY_REDIS_DB=10
JAVA_INTERNAL_NETWORK=fusion_fusion-internal

# 对外端口（只绑回环，公网入口由反向代理接入）。与 Java 的 18080-18089 错开。
GATEWAY_PUBLISH_ADDR=127.0.0.1
GATEWAY_PUBLISH_PORT=18100
ADMIN_PUBLISH_PORT=18101

# 外部服务地址：留空用 compose 内的 mock（需 COMPOSE_PROFILES=mock）；正式环境改成真实地址。
AIGC_ENDPOINT=http://mock-aigc:5055
UNION_BASE_URL=http://mock-union:5056
LINK_PARSE_URL=http://mock-linkparse:5058

# 本地开发起 mock 服务：COMPOSE_PROFILES=mock（生产不要开）
# COMPOSE_PROFILES=mock
