# aigc-life 部署配置。复制成 deploy.env 后按服务器实际情况填写，然后执行：bash install.sh
# 安装后会复制一份到 ${INSTALL_DIR}/deploy.env，以后升级时新包里没有 deploy.env 就用那一份。

# ---------- 安装位置 ----------
INSTALL_DIR=/opt/aigc-life

# ---------- 数据库（现有系统的 fusion_aigc 库）----------
# 宝塔：数据库 → 找到 fusion_aigc → 用户名 / 密码；MySQL 在本机就填 127.0.0.1
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fusion_aigc
DB_USER=root
DB_PASS=
# mysql 客户端路径，留空自动找（宝塔一般在 /www/server/mysql/bin/mysql）
MYSQL_BIN=

# ---------- 端口 ----------
# 注意：宝塔面板默认占用 8888，所以这里不用 8888。
# 只有 GATEWAY_PORT（App 接口）和 ADMIN_PORT（运营后台）需要对外，其余只在本机监听。
GATEWAY_PORT=18888
ADMIN_PORT=18889
COPYWRITING_PORT=19201
DIGITALHUMAN_PORT=19202
NOTE_PORT=19203
IMAGEGEN_PORT=19204
MOCK_PORT=15055

# ---------- AIGC 执行面 ----------
# 目前没有正式地址，用自带的 mock-aigc 联调（MOCK_ENABLED=1）。
# 以后拿到正式地址：MOCK_ENABLED=0，AIGC_ENDPOINT=http://<执行面>:5000，再执行一次 bash install.sh
MOCK_ENABLED=1
AIGC_ENDPOINT=
# mock 生成的「成品」统一用这两个文件（必须公网可访问；会被转存到我们的目录，前端能真实打开/播放）
MOCK_SAMPLE_IMAGE=https://xx-shop-img.oss-cn-hangzhou.aliyuncs.com/images/20260915/9db717232a3645a79f006d92260dc7d4.png
MOCK_SAMPLE_VIDEO=https://xx-shop-img.oss-cn-hangzhou.aliyuncs.com/videos/20260915/e8b22c6d21654a41aec8bca97065921c.mp4

# ---------- 登录（联盟 token → 本服务令牌）----------
# 联盟用户服务地址。登录时前端先自己换一个临时 token，我们拿它来这里换用户信息；
# 留空时登录接口返回「暂未开放」，联调可继续用 X-User-Id
UNION_BASE_URL=https://agent.pengqiwl.com
# 鉴权模式：dev = 没带令牌时信任 X-User-Id（联调用）；token = 只认我们签发的令牌（上线必须用这个）
AUTH_MODE=dev
# 【服务器连不上联盟域名时用这条】自己验临时 token：读联盟的 Redis + 查它的用户表，不走它的 HTTP 接口。
# 配了 UNION_REDIS_ADDR 就走这条，UNION_BASE_URL 会被忽略。
# 联盟的用户库默认复用上面的数据库连接（两个库通常在同一个 MySQL 实例），
# 前提是 DB_USER 对 unionec_app 有读权限（没有就找 DBA 授权：GRANT SELECT ON unionec_app.* TO ...）。
UNION_REDIS_ADDR=
UNION_REDIS_PASS=
# 手机号在联盟库里是 AES 加密的，配了密钥才解得出来；不配则手机号留空（不影响登录）
UNION_PHONE_AES_KEY=

# 令牌签名密钥：留空时首次安装自动生成一串随机值写回本文件，不用手填
JWT_SECRET=
# 运营后台的令牌密钥（与 App 分开，同样自动生成）。后台账号用现有的 afv_admin_user，这里不用配账号。
ADMIN_JWT_SECRET=

# ---------- 分享链接解析（爆款视频复刻的「链接查视频」入口）----------
# 同事的服务：抖音/快手/小红书/B站 分享链接（或整段分享文案）→ 直链 + 标题 + 封面。
# 留空则 App 端只显示「上传视频」，不显示链接入口。
LINK_PARSE_URL=http://101.37.203.33:8000

# ---------- 建档走现有 Java 服务（可选）----------
# 配了这三样，新用户就由 Java 的 /api/v1/union/user-register 建（它写同一张表，还会建团队）；
# 留空则由本服务自己写表（口径已按他们的规则对齐，但他们以后改规则我们得跟着改）。
# 密钥找 Java 那边要（afv_open_app / afv_open_app_secret）。
FUSION_BASE_URL=
FUSION_APP_KEY=
FUSION_APP_SECRET=
# 密钥版本，他们说要带才填
FUSION_KEY_VERSION=

# ---------- 其他 ----------
# 日志保留天数
LOG_KEEP_DAYS=7
