# aigc-local-life 部署配置。复制成 deploy.env 后按服务器实际情况填写，然后执行：bash install.sh
# 安装后会复制一份到 ${INSTALL_DIR}/deploy.env，以后升级时新包里没有 deploy.env 就用那一份。

# ---------- 安装位置 ----------
INSTALL_DIR=/opt/aigc-local-life

# ---------- 数据库（现有系统的 fusion_aigc 库）----------
# 宝塔：数据库 → 找到 fusion_aigc → 用户名 / 密码；MySQL 在本机就填 127.0.0.1
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fusion_aigc
DB_USER=root
DB_PASS=
# mysql 客户端路径，留空自动找（宝塔一般在 /www/server/mysql/bin/mysql）
MYSQL_BIN=

# ---------- 端口 ----------
# 注意：宝塔面板默认占用 8888，所以这里不用 8888。
# 所有端口都只监听 127.0.0.1，不要在安全组里放行：公网入口统一经 nginx（见 PUBLIC_DOMAIN）。
GATEWAY_PORT=18888
ADMIN_PORT=18889
COPYWRITING_PORT=19201
DIGITALHUMAN_PORT=19202
NOTE_PORT=19203
IMAGEGEN_PORT=19204
STUDIO_PORT=19205
ASSETLIB_PORT=19206   # 资产库增强（/api/v1/asset-library）
CANVAS_PORT=19207     # 画布 + 提示词库（/api/v1/canvas、/api/v1/prompt-library）

# ---------- AIGC 执行面 ----------
# 执行面：正式版必须填真实的 AIGC_ENDPOINT（或留空，由 JAVA_ENV_FILE 从 Java 的 .env 读取）。
AIGC_ENDPOINT=   # 留空则读 JAVA_ENV_FILE 里的 AIGC_BASE_URL（推荐，与 Java 一致）

# ---------- 登录（联盟 token → 本服务令牌）----------
# 联盟用户服务地址（与 Java 相同，只走 HTTP：GET {UNION_BASE_URL}/api/v1/auth/{临时token}/user）。登录时前端先自己换一个临时 token；
# 留空时登录接口返回「暂未开放」（App 登录不了）
UNION_BASE_URL=https://agent.pengqiwl.com
# 鉴权模式：正式版只支持 token（只认我们签发的令牌）
AUTH_MODE=token
# 接口文档 /swagger（网关与后台）。正式环境保持 0
SWAGGER_ENABLED=0
# 执行面 task_id 前缀，生成 <前缀>_<32位hex>。只能字母数字，不含下划线
TASK_ID_PREFIX=AiCreationLife

# 【正式环境必填】和 AIGC（Java）服务共用登录会话：配了它的 Redis，我们就发和它**一模一样**的令牌
# （32 位 hex + Redis 里的 fusion:token:* 那套），一个 token 两边都认。
# nginx 把登录、点数余额、素材库、刷新令牌等 /api/v1/ 接口转给 Java，所以 App 的令牌必须两边通用。
# 留空时只能做不经 Java 的单独联调（令牌无法在 Java 接口上使用）；正式版必须配置。
# 会话 Redis 默认从 JAVA_ENV_FILE 读：REDIS_HOST / REDIS_PORT / REDIS_PASSWORD / REDIS_DB（与 Java 完全一致，不用手工抄）。
# 只在要覆盖时才填，填了就以这里为准；库号与 Java 的 REDIS_DB 不一致时安装会直接报错。
SESSION_REDIS_ADDR=
SESSION_REDIS_PASS=
SESSION_REDIS_DB=


# ---------- 分享链接解析（爆款视频复刻的「链接查视频」入口）----------
# 同事的服务：抖音/快手/小红书/B站 分享链接（或整段分享文案）→ 直链 + 标题 + 封面。
# 留空则 App 端只显示「上传视频」，不显示链接入口。
LINK_PARSE_URL=http://101.37.203.33:8000

# ---------- 共享媒体服务（aigc-media：封面 / 水印 / 合成 / 探测 / 抽帧）----------
# imagegen 复刻视频时调它抽封面等。token 必须与 Java 的 MEDIA_SERVICE_TOKEN、media-svc 的 token **完全一致**。
# 裸机形态下 JAVA_ENV_FILE（Java 的 env 文件）是媒体 token 的**唯一权威**，这里留空，token 从 Java 的 MEDIA_SERVICE_TOKEN 读取。
# 若在此填写，install 会要求它与 Java 的 MEDIA_SERVICE_TOKEN 完全相同（不同或 Java 里缺失都会拒绝安装）；
# 不要在两处各维护一份。编排形态（compose）的权威是根 deploy/compose/.env，见 fusion-aigc deploy/RELEASE-media-rnacos.md。
MEDIA_SVC_TOKEN=
# 媒体服务静态回退地址（imagegen 的 BaseURL）；host 网络同机默认 127.0.0.1:18090
MEDIA_SVC_BASE_URL=http://127.0.0.1:18090
# r-nacos 注册中心：media-svc 自注册到此，imagegen 订阅发现；host 网络同机默认 127.0.0.1:8848。
# 置空则 imagegen 只用上面的静态地址（不走服务发现）。
MEDIA_NACOS_ADDR=127.0.0.1:8848
# r-nacos OpenAPI 鉴权账号（须与 r-nacos 初始化管理员、media-svc 的 MEDIA_NACOS_* 一致）
MEDIA_NACOS_USERNAME=
MEDIA_NACOS_PASSWORD=

# ---------- 建档走现有 Java 服务（可选）----------
# 配了这三样，新用户就由 Java 的 /api/v1/union/user-register 建（它写同一张表，还会建团队）；
# 留空则由本服务自己写表（口径已按他们的规则对齐，但他们以后改规则我们得跟着改）。
# 密钥找 Java 那边要（afv_open_app / afv_open_app_secret）。
FUSION_BASE_URL=
FUSION_APP_KEY=
FUSION_APP_SECRET=
# 密钥版本，他们说要带才填
FUSION_KEY_VERSION=

# ---------- 其他 ----------
# 日志保留天数
LOG_KEEP_DAYS=7

# 计费（九个功能 + AI 文案的提交 / 出结果 / 失败 / 删除都已接入）。
# 正式版只接受 on（真扣：点数不够 / 没权益 / 缺计费配置都会拒绝提交）；off、shadow 只用于开发环境。
# 安装时会先做计费配置检查，有问题直接中止安装。
BILLING_MODE=on

# 迁移前整库备份到 ${INSTALL_DIR}/backup/（需要 mysqldump）。默认关闭；
# 首次上线建议设 1：迁移只能前进，备份是唯一的回滚手段。大库备份耗时长、占磁盘，注意空间。
BACKUP_BEFORE_MIGRATE=0

# ---- 公网入口（nginx）：前端只访问这个域名。网关（/api/v1/local-life）与后台（/api/v1/local-life/admin）经 nginx 对外；rpc 与后台端口只绑本机
PUBLIC_DOMAIN=aigc.pengqiwl.com
# Java 服务地址：nginx 把 /api/v1/local-life 以外的 /api/v1/ 接口（登录、点数、素材、刷新令牌等）转给它
JAVA_UPSTREAM=127.0.0.1:18080

# ---- 与 Java 同源的配置：填 Java 服务的 .env 路径，安装时自动读取 AIGC_BASE_URL 与会话参数，
#      保证两边是同一个值。下面三个变量留空时才用这个文件；显式写了就以显式的为准。
JAVA_ENV_FILE=

# ---- 会话与 Java 共用（必须与 Java 生产环境一致，否则两边的会话规则对不上）
# 留空 = 读 JAVA_ENV_FILE（APP_SECURITY_TOKEN_MAX_CONCURRENT_SESSIONS / TOKEN_ACCESS_HOURS / TOKEN_REFRESH_DAYS），读不到用代码默认值 0 / 2 / 7。
SESSION_MAX_CONCURRENT=
TOKEN_ACCESS_HOURS=
TOKEN_REFRESH_DAYS=

# ---------- studio（商拍换装 / 姿态复刻 / 图片生成）----------
# ai-gateway 地址与调用方凭据（ai-gateway 侧 AIG_CALLER_KEYS 登记 caller_id=fusion-go）。AI_GATEWAY_URL 留空 = studio 提交返回「暂未开放」
AI_GATEWAY_URL=
AI_GATEWAY_KEY_ID=fusion-go-v1
AI_GATEWAY_SECRET=
# 生图签名密钥：必须与 ai-gateway 侧 AIG_CALLER_KEYS 里 key_id=fusion-go-v1 那一项的 secret（部署变量 AIG_CALLER_GO_SECRET）**完全一致**，
# 不一致时 studio 每次提交都 401 AUTH_FAILED（hmac.invalid_signature）。
# 反推 sidecar（Python，只监听内网）；留空用默认 http://127.0.0.1:8090。REVERSE_BASE_URL 是同义别名
REVERSE_SIDECAR_URL=
# studio 额外允许的输入图地址前缀（逗号分隔）：素材库公有桶 / CDN 域名，如 https://cdn.example.com/。
# 本服务上传的地址已自动放行；用户从素材库选的图（Java 写进公有桶）不在本服务前缀下，不配这里会被拒「不是本服务上传的地址」
STUDIO_INPUT_URL_PREFIXES=
# 反推 sidecar 经 ai-gateway 调 DeepSeek（不再直连 api.deepseek.com，DeepSeek 官方密钥只在 gateway 管理端配置）。
# 调用方 prompt-reverse 的凭据只映射给 sidecar 容器使用（studio-rpc 等服务不读取；compose 下一次性的 prepare 容器经 env_file 也能看到这个值，但不会写进 etc/）。compose 部署时由 docker-compose.yml 映射成
# sidecar 容器里的 AIG_BASE_URL / AIG_KEY_ID / AIG_SECRET / REVERSE_MODEL_GROUP / REVERSE_ALLOWED_DEPLOYMENTS / AIG_WAIT_S；脚本部署时把同名 AIG_* 写进 sidecar
# 自己的 systemd 环境，不要放进 etc/ 下的任何配置。
# 网关地址：留空复用上面的 AI_GATEWAY_URL
REVERSE_AIG_BASE_URL=
REVERSE_AIG_KEY_ID=prompt-reverse-v1
# 必须与 ai-gateway 侧 AIG_CALLER_REVERSE_SECRET **完全一致**（且不同于 fusion-go 的 secret）；留空 = sidecar llm_configured=false，读图 502
REVERSE_AIG_SECRET=
# 模型组：默认 vlm.deepseek-flash（DeepSeek 官方 deepseek-chat.vl.deepseek-flash 优先，百炼 bailian-chat.vl.deepseek-flash 自动切换备用）
REVERSE_MODEL_GROUP=vlm.deepseek-flash
# 排障钉渠道（可选，逗号分隔）：非空时 sidecar 把它写进 constraints.allowed_deployments，只走这些部署、不再切换备用，
# 如 deepseek-chat.vl.deepseek-flash 或 bailian-chat.vl.deepseek-flash。平时留空，排障完清空
REVERSE_ALLOWED_DEPLOYMENTS=
# 长轮询秒数（1–60）
REVERSE_AIG_WAIT_S=25
# sidecar 镜像与监听端口（compose 部署）；端口只绑 127.0.0.1，不要映射到公网
REVERSE_IMAGE=
REVERSE_PORT=8090

# ---------- canvas（画布 + 提示词库）----------
# 画布的生图 / 生视频 / 反推复用上面 studio 的 AI_GATEWAY_URL / AI_GATEWAY_KEY_ID / AI_GATEWAY_SECRET（同一个调用方 fusion-go），
# 媒体服务复用 MEDIA_SVC_*，试穿经 studio-rpc（STUDIO_PORT），计费档位跟 BILLING_MODE（只计 image / video / 反推）。
# Java 主项目的**内网**地址（不是公网域名，不经 nginx）：放大 / 扩图 / 局部重绘调 Java creaft v1 兼容工具
# （/api/v1/tools/ai-image-upscaler、ai-ratio-convert、ai-inpaint）并轮询 /api/v1/tasks/{taskUid}，透传用户 Bearer，由 Java 计费。
# 一般与 JAVA_UPSTREAM 同一台，如 http://127.0.0.1:18080。留空 = 这三个工具返回「暂未开放」。
CANVAS_JAVA_BASE_URL=
