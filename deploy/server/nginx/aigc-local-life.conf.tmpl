# 本地生活 Go 服务对外入口（install.sh 渲染：__SERVER_NAME__ / __GATEWAY_PORT__ / __ADMIN_PORT__ / __JAVA_UPSTREAM__）
# 放进宝塔站点配置（http 段或该站点的 server 段），HTTPS 证书在宝塔里配，改完 reload nginx。
# 公网只放 /api/v1/（本地生活与 studio 走 Go，其余走 Java），其余一律 404：Go 后台、接口文档、指标都只在本机。

upstream aigc_gateway {
    server 127.0.0.1:__GATEWAY_PORT__;
    keepalive 16;
}
upstream aigc_admin {
    server 127.0.0.1:__ADMIN_PORT__;
    keepalive 16;
}
upstream aigc_java {
    server __JAVA_UPSTREAM__;
    keepalive 16;
}

server {
    listen 80;
    server_name __SERVER_NAME__;

    client_max_body_size 50m;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # 文案、生成类接口有同步等待，别让 nginx 先断
    proxy_read_timeout 300s;

    # 本地生活后台（Go，/api/v1/local-life/admin）：与 Java 后台共用登录令牌（同一个 Redis 会话），
    # 权限按 Java 的 RBAC 逐个接口校验（local_life:view / local_life:update）。前端不需要换地址。
    # 必须放在 /api/v1/local-life 网关 location 之前（这里是更长的前缀，优先匹配）。
    location ^~ /api/v1/local-life/admin {
        proxy_pass http://aigc_admin;
    }

    # App 本地生活接口（Go 网关）。后台前缀 /api/v1/local-life/admin 已在上面单独转发，更长的前缀优先匹配
    location /api/v1/local-life {
        proxy_pass http://aigc_gateway;
    }

    # studio（商拍换装 / 姿态复刻 / 图片生成）：用户侧与管理侧是两个进程，各一条 location。
    # /api/v1/studio/admin → Go 后台，必须写在 /api/v1/studio 之前（同 local-life 的套路）；两条都用 ^~，
    # 命中后不再看正则 location。前缀与 Java 的 31 个一级前缀不撞，都要放在下面的 location /api/v1/ 之前。
    location ^~ /api/v1/studio/admin {
        proxy_pass http://aigc_admin;
    }

    location ^~ /api/v1/studio {
        proxy_pass http://aigc_gateway;
    }

    # 资产库增强（/api/v1/asset-library，Java 的素材接口是 /api/v1/asset，不撞）：同 studio，admin 那条在前。
    location ^~ /api/v1/asset-library/admin {
        proxy_pass http://aigc_admin;
    }

    location ^~ /api/v1/asset-library {
        proxy_pass http://aigc_gateway;
    }

    # 画布（/api/v1/canvas，Java 的画布 AI 操作在 /api/v1/agent/canvas，不撞）与提示词库（/api/v1/prompt-library，
    # Java 是 /api/v1/creation/prompts，不撞）：同 studio，每个前缀 admin 那条在前。
    # 请求体上限三处的关系：
    #   nginx server 级 client_max_body_size 50m（本文件上方，宽松兜底）
    #   gateway-api 的 MaxBytes 11534336（11MB，deploy/etc/gateway-api.yaml，实际生效的入口上限，超了网关返回 413）
    #   canvas-rpc 蒙版 maxMaskBytes 20MB（解码后字节数的内部校验；经网关进来的请求受 11MB 限制，到不了它）。
    # 这里不单独设 client_max_body_size：曾设 4m，会让 base64 后超过 4MB 的局部重绘蒙版在 nginx 就被 413。
    # 继承 server 级 50m，由 gateway 的 11MB 统一把关；调大 gateway MaxBytes 时须保证不超过 server 级值。
    location ^~ /api/v1/canvas/admin {
        proxy_pass http://aigc_admin;
    }

    location ^~ /api/v1/canvas {
        proxy_pass http://aigc_gateway;
    }

    location ^~ /api/v1/prompt-library/admin {
        proxy_pass http://aigc_admin;
    }

    location ^~ /api/v1/prompt-library {
        proxy_pass http://aigc_gateway;
    }

    # Java 的其它后台接口（/api/v1/admin/...）不走公网：运营用内网或 VPN 访问。
    location ^~ /api/v1/admin {
        return 404;
    }

    # 其余 /api/v1/：登录、用户、积分、素材等都是 Java 的接口（与 AIGC 共用会话，令牌刷新也在那边）
    location /api/v1/ {
        proxy_pass http://aigc_java;
    }

    # Java 的接口文档与监控不对公网
    location ~ ^/(swagger-ui|v3/api-docs|actuator) {
        return 404;
    }

    location / {
        return 404;
    }
}
