# fusion-aigc-go 对外入口（install.sh 渲染：__SERVER_NAME__ / __GATEWAY_PORT__ / __JAVA_UPSTREAM__）
# 放进宝塔站点配置（http 段或该站点的 server 段），HTTPS 证书在宝塔里配，改完 reload nginx。
# 公网只放 /api/v1/（本地生活走 Go，其余走 Java），其余一律 404：Go 后台、接口文档、指标都只在本机。

upstream aigc_gateway {
    server 127.0.0.1:__GATEWAY_PORT__;
    keepalive 16;
}
upstream aigc_java {
    server __JAVA_UPSTREAM__;
    keepalive 16;
}

server {
    listen 80;
    server_name __SERVER_NAME__;

    client_max_body_size 50m;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # 文案、生成类接口有同步等待，别让 nginx 先断
    proxy_read_timeout 300s;

    # App 本地生活接口（Go 网关）
    location /api/v1/local-life {
        proxy_pass http://aigc_gateway;
    }

    # Java 的运营后台接口不走公网：运营用内网或 VPN 访问。确需公网访问时删掉这一段。
    location ^~ /api/v1/admin {
        return 404;
    }

    # 其余 /api/v1/：登录、用户、积分、素材等都是 Java 的接口（与 AIGC 共用会话，令牌刷新也在那边）
    location /api/v1/ {
        proxy_pass http://aigc_java;
    }

    # Java 的接口文档与监控不对公网
    location ~ ^/(swagger-ui|v3/api-docs|actuator) {
        return 404;
    }

    location / {
        return 404;
    }
}
