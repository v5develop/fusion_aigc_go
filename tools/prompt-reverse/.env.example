# 复制为 .env 或直接设为环境变量（.env 不随镜像/包分发，也不要提交）
# 模型调用经 ai-gateway（不再直连 DeepSeek）；DeepSeek 官方密钥只在 gateway 管理端配置
AIG_BASE_URL=
AIG_KEY_ID=prompt-reverse-v1
# gateway 管理端为调用方 prompt-reverse 生成的 secret（scopes: calls, catalog）
AIG_SECRET=
AIG_CALLER=prompt-reverse
# 模型组：默认 vlm.deepseek-flash（DeepSeek 官方 tier 0 优先，百炼 tier 1 自动切换备用）
REVERSE_MODEL_GROUP=vlm.deepseek-flash
# 排障钉渠道（可选，逗号分隔）：非空时写入 constraints.allowed_deployments，只走这些部署、不再切换备用；
# 如 deepseek-chat.vl.deepseek-flash（官方）或 bailian-chat.vl.deepseek-flash（百炼）。平时留空
REVERSE_ALLOWED_DEPLOYMENTS=
# 长轮询 GET /v1/calls/{id}?wait= 的秒数（1–60）
AIG_WAIT_S=25
# 监听地址；默认 127.0.0.1:8090，容器内需 0.0.0.0:8090
REVERSE_BIND=127.0.0.1:8090
