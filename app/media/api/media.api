syntax = "v1"

info (
	title:       "媒体服务"
	version:     "v1"
	description: "Java 只发指令，所有下载、探测、截剪、规整、落桶、删除由媒体服务完成。契约说明见 docs/api/media-service.md。写操作必须带 Idempotency-Key。"
)

type (
	// Source 来源：url 与 key 二选一。
	Source {
		Rid   string `json:"rid,optional"`
		Url   string `json:"url,optional"`
		Key   string `json:"key,optional"`
		Store string `json:"store,optional,options=private|asset_library|third_party"`
		// Headers 下载请求头，只能与 url 一起用，且只在 ingest 上生效（其它接口带头返回 400）。
		// 白名单：Authorization、User-Agent、Accept、Referer、Accept-Language；白名单外的头返回 400。
		// 头只随请求发给 url 的来源；跳转到别的来源时剥掉。头的值不写日志、不回显错误、不参与 rid 派生。
		Headers map[string]string `json:"headers,optional"`
	}
	// Rule 参考视频规整规则，字段与网关 VideoConformance 对齐。
	Rule {
		StripAudio bool    `json:"strip_audio,optional"`
		TargetFps  int     `json:"target_fps,optional"`
		MinSide    int     `json:"min_side,optional"`
		MaxSide    int     `json:"max_side,optional"`
		MinPixels  int64   `json:"min_pixels,optional"`
		MaxPixels  int64   `json:"max_pixels,optional"`
		MinRatio   float64 `json:"min_ratio,optional"`
		MaxRatio   float64 `json:"max_ratio,optional"`
	}
	// ObjectRef 落桶后的对象引用（Java 只保存这些字段，不推算对象键）。
	ObjectRef {
		Rid       string  `json:"rid"`
		Class     string  `json:"class"`
		Store     string  `json:"store"`
		Key       string  `json:"key"`
		Sha256    string  `json:"sha256"`
		Size      int64   `json:"size"`
		Mime      string  `json:"mime"`
		DurationS float64 `json:"duration_s"`
		Width     int     `json:"width"`
		Height    int     `json:"height"`
		Fps       float64 `json:"fps"`
		HasAudio  bool    `json:"has_audio"`
	}
	// URLRef 可访问地址：public 为公有地址，signed 为签名地址（带过期时间）。
	URLRef {
		Kind      string `json:"kind"`
		Value     string `json:"value"`
		ExpiresAt string `json:"expires_at,optional"`
	}
	// MediaResult 写操作统一结果。
	MediaResult {
		Object ObjectRef `json:"object"`
		Url    URLRef    `json:"url"`
		// Parents 复制产物的源 rid（仅 resources/copy 返回）；其它写操作不返回该字段。
		Parents []string `json:"parents,optional"`
	}
	// MediaMeta probe 结果（不落桶）。
	MediaMeta {
		Mime      string  `json:"mime"`
		Size      int64   `json:"size"`
		DurationS float64 `json:"duration_s"`
		Width     int     `json:"width"`
		Height    int     `json:"height"`
		Fps       float64 `json:"fps"`
		HasAudio  bool    `json:"has_audio"`
	}
	IngestReq {
		IdempotencyKey string `header:"Idempotency-Key"`
		Source         Source `json:"source"`
		Purpose        string `json:"purpose,options=user_input|intermediate|asset_library|third_party"`
	}
	ProbeReq {
		Source Source `json:"source"`
	}
	FramesReq {
		IdempotencyKey string `header:"Idempotency-Key"`
		Source         Source `json:"source"`
		Count          int    `json:"count,range=[1:32]"`
	}
	FrameItem {
		TimestampS float64   `json:"timestamp_s"`
		Object     ObjectRef `json:"object"`
	}
	FramesResp {
		Frames []FrameItem `json:"frames"`
	}
	CoverReq {
		IdempotencyKey string `header:"Idempotency-Key"`
		Source         Source `json:"source"`
		Purpose        string `json:"purpose,options=user_input|intermediate|asset_library|third_party"`
	}
	WatermarkReq {
		IdempotencyKey string `header:"Idempotency-Key"`
		Source         Source `json:"source"`
		Purpose        string `json:"purpose,options=user_input|intermediate|asset_library|third_party"`
	}
	TrimReq {
		IdempotencyKey string  `header:"Idempotency-Key"`
		Source         Source  `json:"source"`
		Seconds        float64 `json:"seconds,range=(0:600]"`
		Purpose        string  `json:"purpose,options=user_input|intermediate|asset_library|third_party"`
	}
	ConformReq {
		IdempotencyKey string `header:"Idempotency-Key"`
		Source         Source `json:"source"`
		Rule           Rule   `json:"rule"`
		// Seconds 大于 0 时：参考视频比它长则截到它；比它短则返回 422 source_too_short（不截、不延长）。
		Seconds float64 `json:"seconds,optional,range=[0:600]"`
		Purpose string  `json:"purpose,options=user_input|intermediate|asset_library|third_party"`
	}
	// ImageRule 图片规整规则，字段与网关 ImageConformance 对齐。
	ImageRule {
		MinLongSide int      `json:"min_long_side,optional"`
		MaxLongSide int      `json:"max_long_side,optional"`
		MimeTypes   []string `json:"mime_types,optional"`
	}
	ImageConformReq {
		IdempotencyKey string    `header:"Idempotency-Key"`
		Source         Source    `json:"source"`
		Rule           ImageRule `json:"rule"`
		Purpose        string    `json:"purpose,options=user_input|intermediate|asset_library|third_party"`
	}
	// ImageResizeReq 精确尺寸缩放：输出严格为 width×height，不保比例。
	ImageResizeReq {
		IdempotencyKey string `header:"Idempotency-Key"`
		Source         Source `json:"source"`
		Width          int    `json:"width,range=[1:16384]"`
		Height         int    `json:"height,range=[1:16384]"`
		Format         string `json:"format,options=png|jpeg"`
		Purpose        string `json:"purpose,options=user_input|intermediate|asset_library|third_party"`
	}
	// ImageWatermarkReq 展示水印：右下角一组（logo 贴右下、文字在其左侧，版式同 Java ImageWatermarkService）。logo 与 text 至少一个。
	ImageWatermarkReq {
		IdempotencyKey     string  `header:"Idempotency-Key"`
		Source             Source  `json:"source"`
		Logo               *Source `json:"logo,optional"`
		Text               string  `json:"text,optional"`
		LogoScalePercent   int     `json:"logo_scale_percent,optional,range=[0:100]"`
		Margin             *int    `json:"margin,optional,range=[0:4096]"`
		TextSize           int     `json:"text_size,optional,range=[0:512]"`
		TextOpacityPercent *int    `json:"text_opacity_percent,optional,range=[0:100]"`
		Purpose            string  `json:"purpose,options=user_input|intermediate|asset_library|third_party"`
	}
	// ImageGridReq 自适应宫格（1..9 张，排版同 Java GridImageService）。
	ImageGridReq {
		IdempotencyKey string   `header:"Idempotency-Key"`
		Sources        []Source `json:"sources"`
		Gap            *int     `json:"gap,optional,range=[0:512]"`
		RowHeight      int      `json:"row_height,optional,range=[0:4096]"`
		MaxSide        int      `json:"max_side,optional,range=[0:16384]"`
		Purpose        string   `json:"purpose,options=user_input|intermediate|asset_library|third_party"`
	}
	// CropBox 像素矩形：原点在左上角，必须完整落在图内。
	CropBox {
		X      int `json:"x,range=[0:]"`
		Y      int `json:"y,range=[0:]"`
		Width  int `json:"width,range=[1:]"`
		Height int `json:"height,range=[1:]"`
	}
	// CropGrid 行列均分：行优先，单格 floor(W/cols)×floor(H/rows)，余数丢弃。
	CropGrid {
		Rows int `json:"rows,range=[1:64]"`
		Cols int `json:"cols,range=[1:64]"`
	}
	// ImageCropReq 裁剪：boxes 与 grid 二选一（至多 64 个输出）。
	ImageCropReq {
		IdempotencyKey string    `header:"Idempotency-Key"`
		Source         Source    `json:"source"`
		Boxes          []CropBox `json:"boxes,optional"`
		Grid           *CropGrid `json:"grid,optional"`
		Purpose        string    `json:"purpose,options=user_input|intermediate|asset_library|third_party"`
	}
	// ImageCropResp 与请求顺序（grid 为行优先）一一对应；每张有自己的 rid。
	ImageCropResp {
		Crops []MediaResult `json:"crops"`
	}
	// MarkPoint 像素坐标（原点左上角，越界夹到边缘）。
	MarkPoint {
		X      int    `json:"x"`
		Y      int    `json:"y"`
		Radius int    `json:"radius,optional,range=[0:8192]"`
		Color  string `json:"color,optional"`
	}
	// ImageMarkReq 画标记。shape: auto（1 点圆环 / 2 点矩形 / ≥3 点折线，同 Java）|circle|dot|rect|polygon。
	ImageMarkReq {
		IdempotencyKey string      `header:"Idempotency-Key"`
		Source         Source      `json:"source"`
		Marks          []MarkPoint `json:"marks"`
		Shape          string      `json:"shape,optional,options=auto|circle|dot|rect|polygon"`
		Color          string      `json:"color,optional"`
		LineWidth      int         `json:"line_width,optional,range=[0:256]"`
		Format         string      `json:"format,optional,options=jpeg|png"`
		Purpose        string      `json:"purpose,options=user_input|intermediate|asset_library|third_party"`
	}
	UploadTargetReq {
		Class   string `json:"class,options=user"`
		Store   string `json:"store,options=private"`
		IdemKey string `json:"idem_key"`
		Mime    string `json:"mime"`
		Size    int64  `json:"size"`
	}
	UploadTargetResp {
		Rid       string `json:"rid"`
		ObjectKey string `json:"object_key"`
		UploadUrl string `json:"upload_url"`
		ExpiresAt string `json:"expires_at"`
	}
	RegisterReq {
		Rid string `json:"rid"`
	}
	AudioTimelineReq {
		IdempotencyKey string    `header:"Idempotency-Key"`
		Sources        []Source  `json:"sources"`
		Starts         []float64 `json:"starts"`
		TotalSeconds   float64   `json:"total_seconds,range=(0:600]"`
		SampleRate     int       `json:"sample_rate,optional"`
		Channels       int       `json:"channels,optional"`
		Purpose        string    `json:"purpose,options=user_input|intermediate|asset_library|third_party"`
	}
	ReplaceAudioReq {
		IdempotencyKey string `header:"Idempotency-Key"`
		Video          Source `json:"video"`
		Audio          Source `json:"audio"`
		Purpose        string `json:"purpose,options=user_input|intermediate|asset_library|third_party"`
	}
	BurnSubtitlesReq {
		IdempotencyKey string `header:"Idempotency-Key"`
		Video          Source `json:"video"`
		Srt            string `json:"srt"`
		Purpose        string `json:"purpose,options=user_input|intermediate|asset_library|third_party"`
	}
	ComposeReq {
		IdempotencyKey string   `header:"Idempotency-Key"`
		Sources        []Source `json:"sources"`
		Purpose        string   `json:"purpose,options=user_input|intermediate|asset_library|third_party"`
	}
	ExtractAudioReq {
		IdempotencyKey string `header:"Idempotency-Key"`
		Source         Source `json:"source"`
		Purpose        string `json:"purpose,options=user_input|intermediate|asset_library|third_party"`
	}
	AdjustDurationReq {
		IdempotencyKey string  `header:"Idempotency-Key"`
		Source         Source  `json:"source"`
		Factor         float64 `json:"factor,range=(0:100]"`
		Purpose        string  `json:"purpose,options=user_input|intermediate|asset_library|third_party"`
	}
	DeleteReq {
		IdempotencyKey string    `header:"Idempotency-Key"`
		Rid            string    `json:"rid,optional"`
		Object         ObjectRef `json:"object,optional"`
	}
	ResourceURLReq {
		Rid        string `json:"rid"`
		Store      string `json:"store,optional,options=private|asset_library|third_party"`
		Mode       string `json:"mode,options=signed|public"`
		TTLSeconds int64  `json:"ttl_seconds,optional,range=[60:86400]"`
	}
	ResourceURLResp {
		Rid       string `json:"rid"`
		ObjectKey string `json:"object_key"`
		Store     string `json:"store"`
		Mode      string `json:"mode"`
		Size      int64  `json:"size"`
		Url       string `json:"url"`
	}
	// CopyReq 显式复制：POST /v1/mediasvc/resources/copy，返回 MediaResult（parents=[源 rid]）。
	// purpose 只允许 asset_library（asset 类别）与 third_party（deliver 类别）；不允许复制到 user 类别。
	CopyReq {
		IdempotencyKey string `header:"Idempotency-Key"`
		Rid            string `json:"rid"`
		Purpose        string `json:"purpose,options=asset_library|third_party"`
	}
	DeleteResp {
		Deleted     bool   `json:"deleted"`
		State       string `json:"state"`
		DeleteAfter string `json:"delete_after,optional"`
	}
	// RetentionDeleteReq 用户输入保留期删除：POST /v1/mediasvc/resources/retention/delete，只收 user 类别 rid，返回 DeleteResp。
	RetentionDeleteReq {
		IdempotencyKey string `header:"Idempotency-Key"`
		Rid            string `json:"rid"`
	}
	RestoreReq {
		Rid string `json:"rid"`
	}
	RestoreResp {
		Rid      string `json:"rid"`
		Restored bool   `json:"restored"`
	}
	// ---- 视频做同款：区间切段 / 多段拼接（含占位）/ 文字叠加。全部只接受 rid；限制 80 秒、6 段、16 个文字槽位 ----
	CutRange {
		Start float64 `json:"start"`
		End   float64 `json:"end"`
	}
	VideoCutReq {
		IdempotencyKey string     `header:"Idempotency-Key"`
		Source         Source     `json:"source"`
		Segments       []CutRange `json:"segments"`
		Purpose        string     `json:"purpose,options=user_input|intermediate|asset_library|third_party"`
	}
	CutSegment {
		Object ObjectRef `json:"object"`
		Url    URLRef    `json:"url"`
		Start  float64   `json:"start"`
		End    float64   `json:"end"`
	}
	VideoCutResp {
		Segments []CutSegment `json:"segments"`
	}
	Placeholder {
		Duration   float64 `json:"duration"`
		Text       string  `json:"text,optional"`
		FontRid    string  `json:"font_rid,optional"`
		Size       int     `json:"size,optional"`
		Color      string  `json:"color,optional"`
		Background string  `json:"background,optional"`
	}
	ConcatItem {
		Source      *Source      `json:"source,optional"`
		Placeholder *Placeholder `json:"placeholder,optional"`
	}
	VideoConcatReq {
		IdempotencyKey string       `header:"Idempotency-Key"`
		Items          []ConcatItem `json:"items"`
		Width          int          `json:"width,optional"`
		Height         int          `json:"height,optional"`
		Fps            int          `json:"fps,optional"`
		SampleRate     int          `json:"sample_rate,optional"`
		Audio          string       `json:"audio,optional,options=keep|drop"`
		Purpose        string       `json:"purpose,options=user_input|intermediate|asset_library|third_party"`
	}
	ConcatTimelineEntry {
		Index    int     `json:"index"`
		Kind     string  `json:"kind,options=source|placeholder"`
		Start    float64 `json:"start"`
		Duration float64 `json:"duration"`
	}
	VideoConcatResp {
		Object   ObjectRef             `json:"object"`
		Url      URLRef                `json:"url"`
		Timeline []ConcatTimelineEntry `json:"timeline"`
	}
	TextBox {
		X float64 `json:"x"`
		Y float64 `json:"y"`
		W float64 `json:"w"`
		H float64 `json:"h"`
	}
	TextStroke {
		Color string  `json:"color,optional"`
		Width float64 `json:"width"`
	}
	TextShadow {
		Color string `json:"color,optional"`
		Dx    int    `json:"dx,optional"`
		Dy    int    `json:"dy,optional"`
	}
	// TextSlot 文字槽位（视频与图片同一份规格）：自动折行、按框缩放、超长以「…」省略，不溢出框。
	// box 为相对画面的 0~1；size 为最大字号（像素），0 = 按框高自适应；颜色 #RGB/#RRGGBB/#RRGGBBAA；start/end 仅视频，必须成对。
	TextSlot {
		Text       string      `json:"text"`
		Box        TextBox     `json:"box"`
		FontRid    string      `json:"font_rid,optional"`
		Size       int         `json:"size,optional"`
		MinSize    int         `json:"min_size,optional"`
		Color      string      `json:"color,optional"`
		Align      string      `json:"align,optional,options=left|center|right"`
		Valign     string      `json:"valign,optional,options=top|middle|bottom"`
		Stroke     *TextStroke `json:"stroke,optional"`
		Shadow     *TextShadow `json:"shadow,optional"`
		MaxLines   int         `json:"max_lines,optional"`
		LineHeight float64     `json:"line_height,optional"`
		Start      *float64    `json:"start,optional"`
		End        *float64    `json:"end,optional"`
	}
	VideoOverlayTextReq {
		IdempotencyKey string     `header:"Idempotency-Key"`
		Source         Source     `json:"source"`
		Slots          []TextSlot `json:"slots"`
		Purpose        string     `json:"purpose,options=user_input|intermediate|asset_library|third_party"`
	}
	ImageTextReq {
		IdempotencyKey string     `header:"Idempotency-Key"`
		Source         Source     `json:"source"`
		Slots          []TextSlot `json:"slots"`
		Purpose        string     `json:"purpose,options=user_input|intermediate|asset_library|third_party"`
	}
)

@server (
	prefix:  /v1/mediasvc
	timeout: 600s
)
service media {
	@doc "读取来源、按用途落桶。字体（TTF/OTF/TTC/WOFF/WOFF2，按文件头识别）不解码直接落桶；其余做完整解码校验"
	@handler Ingest
	post /ingest (IngestReq) returns (MediaResult)

	@doc "取元数据，不落桶"
	@handler Probe
	post /probe (ProbeReq) returns (MediaMeta)

	@doc "抽帧，返回帧对象列表"
	@handler Frames
	post /frames (FramesReq) returns (FramesResp)

	@doc "代表帧封面"
	@handler Cover
	post /cover (CoverReq) returns (MediaResult)

	@doc "右下角叠加 logo"
	@handler Watermark
	post /watermark (WatermarkReq) returns (MediaResult)

	@doc "截到前 seconds 秒"
	@handler Trim
	post /video/trim (TrimReq) returns (MediaResult)

	@doc "规整：去音轨、帧率、尺寸、比例；可选截剪与过短拒收"
	@handler Conform
	post /video/conform (ConformReq) returns (MediaResult)

	@doc "申请直传目标（只允许用户输入）：返回 rid 与签名 PUT 地址"
	@handler UploadTarget
	post /resources/upload-target (UploadTargetReq) returns (UploadTargetResp)

	@doc "确认直传完成：凭 rid 校验对象存在，返回对象引用"
	@handler Register
	post /resources/register (RegisterReq) returns (MediaResult)

	@doc "图片规整：长边等比缩放进区间；限定格式时转码（PNG 保留透明）；不需要处理时原样落桶"
	@handler ImageConform
	post /image/conform (ImageConformReq) returns (MediaResult)

	@doc "图片精确尺寸缩放：输出 width×height（不保比例）；png 仅在源图有 alpha < 255 的像素时保留 alpha，否则写 RGB；jpeg 铺白底"
	@handler ImageResize
	post /image/resize (ImageResizeReq) returns (MediaResult)

	@doc "图片展示水印：右下角一组（logo 贴右下、文字在其左侧，带阴影），版式同 Java ImageWatermarkService；仅 PNG/JPEG，输出格式同输入"
	@handler ImageWatermark
	post /image/watermark (ImageWatermarkReq) returns (MediaResult)

	@doc "自适应宫格：1..9 张，同行等高、整行居中、白底，最长边限制；排版同 Java GridImageService"
	@handler ImageGrid
	post /image/grid (ImageGridReq) returns (MediaResult)

	@doc "图片裁剪：像素矩形或行列均分，输出多张 PNG（各有 rid，按请求顺序）"
	@handler ImageCrop
	post /image/crop (ImageCropReq) returns (ImageCropResp)

	@doc "图片打标：像素坐标画圆环 / 实心点 / 矩形 / 折线，默认红色，JPEG 95（可选 PNG）"
	@handler ImageMark
	post /image/mark (ImageMarkReq) returns (MediaResult)

	@doc "按区间切段（视频做同款）：只接受 rid；1~6 段，重编码保起点精确（毫秒），区间可重叠；越界 422 source_too_short(video.cut_out_of_range)；源视频 ≤ 80 秒"
	@handler VideoCut
	post /video/cut (VideoCutReq) returns (VideoCutResp)

	@doc "多段拼接（视频做同款）：1~6 项有序，rid 或占位画面（纯色底+居中文字，失败段预览用）；规格统一到第一个真实段或参数指定；可去音轨；总时长 ≤ 85 秒；返回成片 rid 与时间轴"
	@handler VideoConcat
	post /video/concat (VideoConcatReq) returns (VideoConcatResp)

	@doc "视频文字叠加：槽位（相对框、自动折行/缩放/省略、描边阴影、start/end 分时显示），字体用 font 摄入的 rid；重编码保留音轨"
	@handler VideoOverlayText
	post /video/overlay-text (VideoOverlayTextReq) returns (MediaResult)

	@doc "图片文字叠加：与 video/overlay-text 同一份槽位规格；仅 PNG/JPEG，输出格式同输入"
	@handler ImageText
	post /image/text (ImageTextReq) returns (MediaResult)

	@doc "配音时间线：按起点拼成整条音轨（m4a）"
	@handler AudioTimeline
	post /audio/timeline (AudioTimelineReq) returns (MediaResult)

	@doc "换音轨：视频流拷贝，按短的一方截断"
	@handler ReplaceAudio
	post /video/replace-audio (ReplaceAudioReq) returns (MediaResult)

	@doc "烧录字幕（固定样式）"
	@handler BurnSubtitles
	post /video/burn-subtitles (BurnSubtitlesReq) returns (MediaResult)

	@doc "按顺序拼接"
	@handler Compose
	post /compose (ComposeReq) returns (MediaResult)

	@doc "抽音轨"
	@handler ExtractAudio
	post /audio/extract (ExtractAudioReq) returns (MediaResult)

	@doc "变速"
	@handler AdjustDuration
	post /video/adjust-duration (AdjustDurationReq) returns (MediaResult)

	@doc "凭 rid 现签访问地址（类别由 rid 决定，请求里不传 class）"
	@handler ResourceURLs
	post /resources/urls (ResourceURLReq) returns (ResourceURLResp)

	@doc "删除中间产物；用户输入（user 类别）与历史 sha256 路径一律拒绝；可用 rid 或 object 指定"
	@handler Restore
	post /resources/restore (RestoreReq) returns (RestoreResp)

	@handler Delete
	post /delete (DeleteReq) returns (DeleteResp)

	@doc "用户输入保留期删除：只收 user 类别 rid（其余 403 purpose.not_user_class），软删除语义同 delete"
	@handler RetentionDelete
	post /resources/retention/delete (RetentionDeleteReq) returns (DeleteResp)
}

