syntax = "v1"

info (
	title:                       "AIGC 本地生活 App 接口"
	version:                     "v1"
	description:                 "HTTP 状态码一律 200，用响应里的 code 判断，业务数据在 data 里。提交生成类接口必须带 Idempotency-Key（UUID，重试沿用同一个）。旧版本只带 X-Request-Id 时仍可用；两者同时带时以 Idempotency-Key 为准，X-Request-Id 用于链路追踪。完整说明见安装目录 docs/ 下的接口文档。"
	schemes:                     "http,https"
	consumes:                    "application/json"
	produces:                    "application/json"
	wrapCodeMsg:                 true
	bizCodeEnumDescription:      "0-成功<br>1000-服务异常，稍后重试<br>1001-参数错误，直接展示 msg<br>1002-未登录<br>1003-不存在或不属于当前用户<br>1005-状态冲突<br>1006-暂未开放 / 形象未生成完成<br>1007-未同意《AIGC功能使用约定》<br>1008-点数不足（计费未接）"
	securityDefinitionsFromJson: `{"auth":{"type":"apiKey","in":"header","name":"Authorization","description":"Bearer <登录接口返回的 token>；联调也可改填 X-User-Id 请求头"}}`
)

type (
	IdPath {
		Id int64 `path:"id"`
	}
	EmptyResp  {}
	Option {
		Code  string `json:"code"`
		Label string `json:"label"`
		Value string `json:"value"`
	}
	ModelInfo {
		Name string `json:"name"`
		Code string `json:"code"`
	}
	OptionsResp {
		ContentTypes    []Option  `json:"content_types"`
		Styles          []Option  `json:"styles"`
		Industries      []Option  `json:"industries"`
		WordCounts      []Option  `json:"word_counts"`
		Model           ModelInfo `json:"model"`
		MaxTopicLen     int32     `json:"max_topic_len"`
		MaxReferenceLen int32     `json:"max_reference_len"`
	}
	AiWriteReq {
		Scene       string `json:"scene,options=topic|selling_point|dh_script|note_topic|poster_info|long_image|voiceover|explore_shop|short_drama"`
		ContentType string `json:"content_type,optional"`
		Industry    string `json:"industry,optional"`
		Context     string `json:"context,optional"` // 用户已输入的内容，可为空，最多 500 字
		MaxLen      int32  `json:"max_len,optional"`
		NoteType    string `json:"note_type,optional"` // note_topic 场景：探店/种草/情感/知识
	}
	AiWriteResp {
		Text string `json:"text"`
	}
	Copywriting {
		Id               int64  `json:"id"`
		Source           string `json:"source"`
		ContentType      string `json:"content_type"`
		ContentTypeLabel string `json:"content_type_label"`
		Style            string `json:"style"`
		Industry         string `json:"industry"`
		Title            string `json:"title"`
		Body             string `json:"body"`
		WordCount        int32  `json:"word_count"`
		Topic            string `json:"topic"`
		TargetWords      int32  `json:"target_words"`
		Status           int32  `json:"status"`
		FailReason       string `json:"fail_reason"`
		CreateTime       int64  `json:"create_time"`
	}
	GenerateReq {
		RequestId     string `header:"Idempotency-Key"`
		Source        string `json:"source,options=AI_WRITE|IMITATE"`
		ContentType   string `json:"content_type,optional"`
		Style         string `json:"style,optional"`
		Industry      string `json:"industry,optional"`
		Topic         string `json:"topic,optional"`
		ReferenceText string `json:"reference_text,optional"`
		TargetWords   int32  `json:"target_words,optional"`
		ShopProfileId int64  `json:"shop_profile_id,optional"`
	}
	RegenerateReq {
		RequestId string `header:"Idempotency-Key"`
		Id        int64  `path:"id"`
	}
	CreateReq {
		Title string `json:"title,optional"`
		Body  string `json:"body"`
	}
	UpdateReq {
		Id    int64  `path:"id"`
		Title string `json:"title,optional"`
		Body  string `json:"body"`
	}
	ListReq {
		Keyword     string `form:"keyword,optional"`
		ContentType string `form:"content_type,optional"`
		// Status 选填：0 生成中 / 1 已完成 / 2 失败；不传或 -1 = 不限（「选择AI文案」弹窗传 1）
		Status   int32 `form:"status,optional,default=-1"`
		Page     int64 `form:"page,optional,default=1"`
		PageSize int64 `form:"page_size,optional,default=20"`
	}
	ListResp {
		List  []Copywriting `json:"list"`
		Total int64         `json:"total"`
	}
	DerivativesReq {
		Id       int64  `path:"id"`
		Kind     string `form:"kind,optional,options=all|note|poster|long_image|voiceover|digital_human|explore_video|promo_drama"`
		Page     int64  `form:"page,optional,default=1"`
		PageSize int64  `form:"page_size,optional,default=20"`
	}
	Derivative {
		Id         int64  `json:"id"` // 业务记录 id：笔记 id / 生成记录 id / 视频 id / 数字人 id，用它打开成品页
		Kind       string `json:"kind"`
		Size       string `json:"size"` // 成品比例，如 9:16（笔记与数字人没有，为空）；用来区分横版竖版
		CoverUrl   string `json:"cover_url"`
		ResultUrl  string `json:"result_url"`
		IsVideo    bool   `json:"is_video"`
		CreateTime int64  `json:"create_time"`
	}
	DerivativesResp {
		List  []Derivative `json:"list"`
		Total int64        `json:"total"`
	}
)

@server (
	prefix:     /api/v1/local-life
	middleware: Auth
	group:      copywriting
	tags:       "AI文案"
	authType:   auth
)
service gateway-api {
	@doc "文案选项：内容类型/风格/行业/字数 + 当前模型"
	@handler options
	get /copywriting/options returns (OptionsResp)

	@doc "AI帮写 / AI优化（同步）"
	@handler aiWrite
	post /copywriting/ai-write (AiWriteReq) returns (AiWriteResp)

	@doc "AI帮写或爆款仿写：提交生成"
	@handler generate
	post /copywriting/generate (GenerateReq) returns (Copywriting)

	@doc "重新生成"
	@handler regenerate
	post /copywriting/:id/regenerate (RegenerateReq) returns (Copywriting)

	@doc "自主撰写：保存文案"
	@handler create
	post /copywriting (CreateReq) returns (Copywriting)

	@doc "文案列表（含搜索）"
	@handler list
	get /copywriting (ListReq) returns (ListResp)

	@doc "文案详情（生成中轮询此接口）"
	@handler get
	get /copywriting/:id (IdPath) returns (Copywriting)

	@doc "编辑文案"
	@handler update
	put /copywriting/:id (UpdateReq) returns (Copywriting)

	@doc "删除文案"
	@handler remove
	delete /copywriting/:id (IdPath) returns (EmptyResp)

	@doc "生成历史：该文案被拿去生成过哪些成品（只返回已完成的）"
	@handler derivatives
	get /copywriting/:id/derivatives (DerivativesReq) returns (DerivativesResp)
}

// ---------------- AI 数字人 ----------------
type (
	AgreementResp {
		Code     string `json:"code"`
		Version  int32  `json:"version"`
		Accepted bool   `json:"accepted"`
	}
	UploadResp {
		Url         string `json:"url"`
		Size        int64  `json:"size"`
		ContentType string `json:"content_type"`
	}
	UploadCredentialReq {
		Kind string `form:"kind,options=image|video"`
	}
	PresignUploadReq {
		Kind        string `json:"kind,options=image|video"`
		ContentType string `json:"content_type"` // 文件类型，如 image/jpeg；PUT 时 Content-Type 必须与它完全一致
	}
	PresignUploadResp {
		PutUrl      string `json:"put_url"` // 用 PUT 把文件原样传到这里（请求体就是文件内容）
		Url         string `json:"url"` // 上传成功后的文件地址，提交给业务接口（如 image_url）
		ContentType string `json:"content_type"` // PUT 时必须带的 Content-Type
		ExpiresAt   int64  `json:"expires_at"` // put_url 过期时间（unix 毫秒），过期重新取
	}
	UploadCredentialResp {
		AccessKeyId     string `json:"access_key_id"`
		AccessKeySecret string `json:"access_key_secret"`
		SecurityToken   string `json:"security_token"`
		Expiration      string `json:"expiration"`
		Bucket          string `json:"bucket"`
		Host            string `json:"host"`
		Dir             string `json:"dir"`
		BaseUrl         string `json:"base_url"`
	}
	PublicDigitalHuman {
		Id        int64  `json:"id"`
		Name      string `json:"name"`
		RoleLabel string `json:"role_label"`
		ImageUrl  string `json:"image_url"`
		AvatarUrl string `json:"avatar_url"`
	}
	PublicListResp {
		List []PublicDigitalHuman `json:"list"`
	}
	DhOptionsResp {
		Genders           []Option `json:"genders"`
		Ages              []Option `json:"ages"`
		SkinTones         []Option `json:"skin_tones"`
		Roles             []Option `json:"roles"`
		Models            []Option `json:"models"` // 出片模型：seedance2.5 / lite，第一项为默认
		MaxDescriptionLen int32    `json:"max_description_len"`
		MaxScriptLen      int32    `json:"max_script_len"`
	}
	CreatePortraitReq {
		RequestId   string `header:"Idempotency-Key"`
		Gender      string `json:"gender,options=female|male"`
		Age         string `json:"age"`
		SkinTone    string `json:"skin_tone"`
		Role        string `json:"role,optional"`
		Description string `json:"description,optional"`
	}
	Portrait {
		Id          int64    `json:"id"`
		Gender      string   `json:"gender"`
		Age         string   `json:"age"`
		SkinTone    string   `json:"skin_tone"`
		Role        string   `json:"role"`
		Description string   `json:"description"`
		Status      int32    `json:"status"`
		ImageUrls   []string `json:"image_urls"`
		FailReason  string   `json:"fail_reason"`
		CreateTime  int64    `json:"create_time"`
	}
	VoiceCategoriesResp {
		List []Option `json:"list"`
	}
	ListVoicesReq {
		Category string `form:"category,optional"`
	}
	Voice {
		Id         int64    `json:"id"`
		Name       string   `json:"name"`
		Gender     string   `json:"gender"`
		Style      string   `json:"style"`
		Categories []string `json:"categories"`
		PreviewUrl string   `json:"preview_url"`
	}
	VoiceListResp {
		List []Voice `json:"list"`
	}
	CreateDigitalHumanReq {
		RequestId      string `header:"Idempotency-Key"`
		CopywritingId  int64  `json:"copywriting_id,optional"` // 选填：配音内容来自哪条 AI文案（用于文案的生成历史）
		Name           string `json:"name,optional"`
		PortraitSource string `json:"portrait_source,options=UPLOAD|PUBLIC|AI"`
		ImageUrl       string `json:"image_url,optional"`
		PublicId       int64  `json:"public_id,optional"`
		PortraitId     int64  `json:"portrait_id,optional"`
		ImageIndex     int32  `json:"image_index,optional"`
		VoiceId        int64  `json:"voice_id"`
		Script         string `json:"script"`
		Model          string `json:"model,optional"` // 出片模型，不传用 options 里的第一项（seedance2.5）
	}
	DigitalHuman {
		Id             int64  `json:"id"`
		Name           string `json:"name"`
		PortraitSource string `json:"portrait_source"`
		ImageUrl       string `json:"image_url"`
		VoiceId        int64  `json:"voice_id"`
		VoiceName      string `json:"voice_name"`
		Script         string `json:"script"`
		VideoUrl       string `json:"video_url"`
		CoverUrl       string `json:"cover_url"`
		Duration       int32  `json:"duration"`
		Model          string `json:"model"`
		Status         int32  `json:"status"`
		FailReason     string `json:"fail_reason"`
		CreateTime     int64  `json:"create_time"`
	}
	ListDigitalHumansReq {
		Status   int32 `form:"status,optional,default=-1"`
		Page     int64 `form:"page,optional,default=1"`
		PageSize int64 `form:"page_size,optional,default=20"`
	}
	DigitalHumanListResp {
		List  []DigitalHuman `json:"list"`
		Total int64          `json:"total"`
	}
)

@server (
	prefix:     /api/v1/local-life
	middleware: Auth
	group:      common
	tags:       "上传"
	authType:   auth
)
service gateway-api {
	@doc "AIGC 功能使用约定：是否已同意当前版本"
	@handler getAgreement
	get /agreements/aigc returns (AgreementResp)

	@doc "同意 AIGC 功能使用约定"
	@handler acceptAgreement
	post /agreements/aigc/accept returns (AgreementResp)

	@doc "预签名上传地址（推荐）：后端签好 PUT 地址，前端直接 PUT 文件，无需密钥与签名"
	@handler presignUpload
	post /upload/presign (PresignUploadReq) returns (PresignUploadResp)

	@doc "客户端直传 OSS 的临时凭证（限定只能写返回的 dir 目录）"
	@handler uploadCredential
	get /upload/credentials (UploadCredentialReq) returns (UploadCredentialResp)

	@doc "上传照片（multipart 字段 file）。仅开发/本地存储用，线上前端走直传"
	@handler upload
	post /upload returns (UploadResp)
}

@server (
	prefix:     /api/v1/local-life
	middleware: Auth
	group:      digitalhuman
	tags:       "AI数字人"
	authType:   auth
)
service gateway-api {
	@doc "公共数字人列表"
	@handler listPublic
	get /digital-humans/public returns (PublicListResp)

	@doc "AI 定制选项：性别/年龄/肤色/职业角色"
	@handler options
	get /digital-humans/options returns (DhOptionsResp)

	@doc "AI 定制形象：提交生成（4 张 9:16 图）"
	@handler createPortrait
	post /digital-humans/portraits (CreatePortraitReq) returns (Portrait)

	@doc "AI 定制形象：查询（生成中轮询此接口）"
	@handler getPortrait
	get /digital-humans/portraits/:id (IdPath) returns (Portrait)

	@doc "AI 定制形象：重新生成"
	@handler regeneratePortrait
	post /digital-humans/portraits/:id/regenerate (RegenerateReq) returns (Portrait)

	@doc "系统音色分类"
	@handler voiceCategories
	get /voices/categories returns (VoiceCategoriesResp)

	@doc "系统音色列表"
	@handler listVoices
	get /voices (ListVoicesReq) returns (VoiceListResp)

	@doc "开始生成数字人"
	@handler create
	post /digital-humans (CreateDigitalHumanReq) returns (DigitalHuman)

	@doc "我的数字人列表"
	@handler list
	get /digital-humans (ListDigitalHumansReq) returns (DigitalHumanListResp)

	@doc "数字人详情（生成中轮询此接口）"
	@handler get
	get /digital-humans/:id (IdPath) returns (DigitalHuman)

	@doc "删除数字人"
	@handler remove
	delete /digital-humans/:id (IdPath) returns (EmptyResp)
}

// ---------------- AI 图文笔记 ----------------
type (
	NoteType {
		Code          string `json:"code"`
		Label         string `json:"label"`
		MaterialLabel string `json:"material_label"`
		MaterialHint  string `json:"material_hint"`
	}
	NoteOptionsResp {
		Types         []NoteType `json:"types"`
		MaxMaterials  int32      `json:"max_materials"` // 上传素材上限 3
		DefaultImages int32      `json:"default_images"` // 套图数量默认值；套图数量不设上限
		MaxEditImages int32      `json:"max_edit_images"` // 编辑时图片上限 3（生成张数更多时以生成张数为准）
		MaxTopicLen   int32      `json:"max_topic_len"`
	}
	PlanNoteReq {
		RequestId      string   `header:"Idempotency-Key"`
		CopywritingId  int64    `json:"copywriting_id,optional"` // 选填：正文来自哪条 AI文案（用于文案的生成历史）
		NoteType       string   `json:"note_type,options=explore|seeding|emotion|knowledge"`
		ShopProfileId  int64    `json:"shop_profile_id,optional"` // 选填：关联店铺档案
		Topic          string   `json:"topic"`
		MaterialUrls   []string `json:"material_urls,optional"`
		DigitalHumanId int64    `json:"digital_human_id,optional"`
		ImageCount     int32    `json:"image_count,optional"` // 套图数量，不传用默认值
	}
	ReplanNoteReq {
		Id         int64 `path:"id"`
		ImageCount int32 `json:"image_count,optional"` // 选填：换套图数量重新构思
	}
	GenerateNoteReq {
		Id         int64    `path:"id"`
		Title      string   `json:"title,optional"`
		Content    string   `json:"content,optional"`
		Tags       []string `json:"tags,optional"`
		ImageCount int32    `json:"image_count,optional"`
	}
	UpdateNoteReq {
		Id        int64    `path:"id"`
		Title     string   `json:"title"`
		Content   string   `json:"content"`
		Tags      []string `json:"tags,optional"`
		ImageUrls []string `json:"image_urls"`
	}
	Note {
		Id             int64    `json:"id"`
		NoteType       string   `json:"note_type"`
		NoteTypeLabel  string   `json:"note_type_label"`
		Topic          string   `json:"topic"`
		MaterialUrls   []string `json:"material_urls"`
		DigitalHumanId int64    `json:"digital_human_id"`
		ShopProfileId  int64    `json:"shop_profile_id"`
		Title          string   `json:"title"`
		Content        string   `json:"content"`
		Tags           []string `json:"tags"`
		ImageCount     int32    `json:"image_count"`
		ImageUrls      []string `json:"image_urls"`
		Status         int32    `json:"status"`
		FailReason     string   `json:"fail_reason"`
		CreateTime     int64    `json:"create_time"`
	}
	ListNotesReq {
		Status   int32 `form:"status,optional,default=-1"`
		Page     int64 `form:"page,optional,default=1"`
		PageSize int64 `form:"page_size,optional,default=20"`
	}
	NoteListResp {
		List  []Note `json:"list"`
		Total int64  `json:"total"`
	}
)

@server (
	prefix:     /api/v1/local-life
	middleware: Auth
	group:      note
	tags:       "AI图文笔记"
	authType:   auth
)
service gateway-api {
	@doc "图文笔记表单配置：笔记类型、素材与套图上限"
	@handler options
	get /notes/options returns (NoteOptionsResp)

	@doc "开始构思笔记（异步，轮询详情；完成后进入规划页）"
	@handler plan
	post /notes/plan (PlanNoteReq) returns (Note)

	@doc "规划页「重新生成」：重新构思"
	@handler replan
	post /notes/:id/replan (ReplanNoteReq) returns (Note)

	@doc "确认开始生成；生成失败后再次调用即重新生成"
	@handler generate
	post /notes/:id/generate (GenerateNoteReq) returns (Note)

	@doc "笔记列表（素材库接入前使用）"
	@handler list
	get /notes (ListNotesReq) returns (NoteListResp)

	@doc "笔记详情（构思中/生成中轮询此接口）"
	@handler get
	get /notes/:id (IdPath) returns (Note)

	@doc "编辑笔记：标题、正文、话题、图片"
	@handler update
	put /notes/:id (UpdateNoteReq) returns (Note)

	@doc "删除笔记"
	@handler remove
	delete /notes/:id (IdPath) returns (EmptyResp)
}

// ---------------- AI 海报 / AI 长图 ----------------
type (
	CreationOption {
		Code  string `json:"code"`
		Label string `json:"label"`
	}
	CreationOptionsReq {
		Kind string `form:"kind,options=poster|longImage|actionTransfer|voiceover"`
	}
	CreationOptionsResp {
		PosterTypes      []CreationOption `json:"poster_types"`
		PosterStyles     []CreationOption `json:"poster_styles"`
		Sizes            []CreationOption `json:"sizes"`
		DefaultSize      string           `json:"default_size"`
		MaxImages        int32            `json:"max_images"`
		MaxMaterials     int32            `json:"max_materials"`
		MaxContentLen    int32            `json:"max_content_len"` // 0 = 不限（数字人口播）
		TemplateRequired bool             `json:"template_required"`
		Models           []CreationOption `json:"models"` // 动作迁移、数字人口播的模型选择
		DefaultModel     string           `json:"default_model"` // 数字人口播默认模型
		Durations        []int32          `json:"durations"` // 数字人口播的视频时长（秒）
		DefaultDuration  int32            `json:"default_duration"` // 数字人口播默认时长
	}
	CreationTemplatesReq {
		Kind       string `form:"kind,options=poster|longImage|voiceover"` // voiceover：预设背景
		PosterType string `form:"poster_type,optional"`
	}
	CreationTemplate {
		Id    int64  `json:"id"`
		Title string `json:"title"`
		Url   string `json:"url"`
	}
	CreationTemplatesResp {
		List []CreationTemplate `json:"list"`
	}
	CreateCreationReq {
		RequestId     string   `header:"Idempotency-Key"`
		CopywritingId int64    `json:"copywriting_id,optional"` // 选填：内容来自哪条 AI文案（用于文案的生成历史）
		Kind          string   `json:"kind,options=poster|longImage|actionTransfer|voiceover"`
		Content       string   `json:"content,optional"` // 海报信息 / 长图内容 / 口播文案
		MaterialUrls  []string `json:"material_urls,optional"`
		TemplateId    int64    `json:"template_id,optional"`
		PosterType    string   `json:"poster_type,optional"`
		PosterStyle   string   `json:"poster_style,optional"`
		Size          string   `json:"size,optional"`
		ImageCount    int32    `json:"image_count,optional"`
		// 动作迁移
		PortraitSource  string `json:"portrait_source,optional,options=|UPLOAD|PUBLIC|AI"`
		ImageUrl        string `json:"image_url,optional"`
		PublicId        int64  `json:"public_id,optional"`
		PortraitId      int64  `json:"portrait_id,optional"`
		ImageIndex      int32  `json:"image_index,optional"`
		ActionVideoId   int64  `json:"action_video_id,optional"`
		MyActionVideoId int64  `json:"my_action_video_id,optional"`
		Model           string `json:"model,optional"`
		// 数字人口播（文案用 content、比例用 size、人物图同动作迁移）
		BackgroundSource string `json:"background_source,optional,options=|AI|PRESET|UPLOAD"`
		BackgroundId     int64  `json:"background_id,optional"`
		BackgroundUrl    string `json:"background_url,optional"`
		Duration         int32  `json:"duration,optional"`
	}
	ActionVideo {
		Id       int64  `json:"id"`
		Name     string `json:"name"`
		Url      string `json:"url"`
		CoverUrl string `json:"cover_url"`
		Mine     bool   `json:"mine"`
	}
	ActionVideoListResp {
		Presets []ActionVideo `json:"presets"`
		Mine    []ActionVideo `json:"mine"`
	}
	ImportActionVideoReq {
		Url      string `json:"url"`
		CoverUrl string `json:"cover_url,optional"`
		Name     string `json:"name,optional"`
	}
	Creation {
		Id            int64    `json:"id"`
		Kind          string   `json:"kind"`
		Media         string   `json:"media"` // image / video，由 kind 决定：口播、动作迁移是视频
		Content       string   `json:"content"`
		MaterialUrls  []string `json:"material_urls"`
		TemplateId    int64    `json:"template_id"`
		TemplateUrl   string   `json:"template_url"`
		PosterType    string   `json:"poster_type"`
		PosterStyle   string   `json:"poster_style"`
		Size          string   `json:"size"`
		ImageCount    int32    `json:"image_count"`
		ImageUrls     []string `json:"image_urls"` // 图片成品；视频成品为空
		VideoUrl      string   `json:"video_url"` // 视频成品（口播、动作迁移）；图片成品为空
		InputImageUrl string   `json:"input_image_url"`
		InputVideoUrl string   `json:"input_video_url"`
		Model         string   `json:"model"`
		InputBgUrl    string   `json:"input_bg_url"` // 数字人口播的背景图；空=AI智能匹配
		Duration      int32    `json:"duration"` // 数字人口播的视频时长（秒）
		Status        int32    `json:"status"`
		FailReason    string   `json:"fail_reason"`
		CreateTime    int64    `json:"create_time"`
	}
	ListCreationReq {
		Kind     string `form:"kind,optional,options=|poster|longImage|actionTransfer|voiceover"`
		Status   int32  `form:"status,optional,default=-1"`
		Page     int64  `form:"page,optional,default=1"`
		PageSize int64  `form:"page_size,optional,default=20"`
	}
	CreationListResp {
		List  []Creation `json:"list"`
		Total int64      `json:"total"`
	}
)

@server (
	prefix:     /api/v1/local-life
	middleware: Auth
	group:      imagegen
	tags:       "海报 / 长图 / 动作迁移 / 数字人口播"
	authType:   auth
)
service gateway-api {
	@doc "表单配置（海报/长图/动作迁移/数字人口播）"
	@handler options
	get /creations/options (CreationOptionsReq) returns (CreationOptionsResp)

	@doc "模板列表（海报可按类型筛；数字人口播为预设背景）"
	@handler templates
	get /creations/templates (CreationTemplatesReq) returns (CreationTemplatesResp)

	@doc "提交生成（一次可出多张，异步）"
	@handler create
	post /creations (CreateCreationReq) returns (Creation)

	@doc "列表"
	@handler list
	get /creations (ListCreationReq) returns (CreationListResp)

	@doc "详情（生成中轮询此接口）"
	@handler get
	get /creations/:id (IdPath) returns (Creation)

	@doc "删除"
	@handler remove
	delete /creations/:id (IdPath) returns (EmptyResp)

	@doc "动作视频：预置（运营维护）+ 我导入的"
	@handler actionVideos
	get /action-videos returns (ActionVideoListResp)

	@doc "导入动作视频（前端直传后回传地址）"
	@handler importActionVideo
	post /action-videos (ImportActionVideoReq) returns (ActionVideo)

	@doc "删除我导入的动作视频"
	@handler removeActionVideo
	delete /action-videos/:id (IdPath) returns (EmptyResp)
}

// ---------------- 店铺档案 ----------------
type (
	ShopProfileForm {
		Name           string `json:"name"` // 店铺名称，必填，≤20 字符（汉字算 2）
		OpenDate       string `json:"open_date,optional"` // 开店时间，日期选择器选中后按文本传，如 2025-10-03
		Address        string `json:"address,optional"` // ≤60
		Products       string `json:"products,optional"` // 提供商品/服务，≤180
		SellingPoints  string `json:"selling_points,optional"` // 核心卖点，≤220
		SelfTitle      string `json:"self_title,optional"` // 如何称呼自己，≤15
		TargetAudience string `json:"target_audience,optional"` // 主要目标客群，≤40
	}
	SaveShopProfileReq {
		Id             int64  `path:"id"`
		Name           string `json:"name"`
		OpenDate       string `json:"open_date,optional"`
		Address        string `json:"address,optional"`
		Products       string `json:"products,optional"`
		SellingPoints  string `json:"selling_points,optional"`
		SelfTitle      string `json:"self_title,optional"`
		TargetAudience string `json:"target_audience,optional"`
	}
	ShopProfile {
		Id             int64  `json:"id"`
		Name           string `json:"name"`
		OpenDate       string `json:"open_date"`
		Address        string `json:"address"`
		Products       string `json:"products"`
		SellingPoints  string `json:"selling_points"`
		SelfTitle      string `json:"self_title"`
		TargetAudience string `json:"target_audience"`
		CreateTime     int64  `json:"create_time"`
		UpdateTime     int64  `json:"update_time"`
	}
	ShopProfileListReq {
		Page     int64 `form:"page,optional,default=1"`
		PageSize int64 `form:"page_size,optional,default=20"`
	}
	ShopProfileListResp {
		List  []ShopProfile `json:"list"`
		Total int64         `json:"total"`
	}
)

@server (
	prefix:     /api/v1/local-life
	middleware: Auth
	group:      shopprofile
	tags:       "店铺档案"
	authType:   auth
)
service gateway-api {
	@doc "店铺档案列表"
	@handler listShopProfiles
	get /shop-profiles (ShopProfileListReq) returns (ShopProfileListResp)

	@doc "创建店铺档案"
	@handler createShopProfile
	post /shop-profiles (ShopProfileForm) returns (ShopProfile)

	@doc "档案详情（编辑页回填）"
	@handler getShopProfile
	get /shop-profiles/:id (IdPath) returns (ShopProfile)

	@doc "保存店铺档案"
	@handler saveShopProfile
	put /shop-profiles/:id (SaveShopProfileReq) returns (ShopProfile)

	@doc "删除店铺档案"
	@handler removeShopProfile
	delete /shop-profiles/:id (IdPath) returns (EmptyResp)
}

// ---------------- 探店视频 / 带货短剧（两步：先出剧本，确认后出片）----------------
type (
	VideoOptionsReq {
		Kind string `form:"kind,options=exploreShop|shortDrama|videoRemake"`
	}
	GenerateVideoReq {
		Id int64 `path:"id"`
		// 下面三个只对视频复刻（videoRemake）生效，都选填；探店 / 短剧不用传
		Prompt string `json:"prompt,optional"` // 改过的剧情文本，不传沿用解析结果
		Model  string `json:"model,optional"` // 模型，取 options 的 models
		Size   string `json:"size,optional"` // 比例 9:16 / 16:9，不传跟原片
	}
	VideoOptionsResp {
		Models              []CreationOption `json:"models"`
		DefaultModel        string           `json:"default_model"`
		Durations           []int32          `json:"durations"`
		DefaultDuration     int32            `json:"default_duration"`
		Sizes               []CreationOption `json:"sizes"`
		DefaultSize         string           `json:"default_size"`
		MaxUserTextLen      int32            `json:"max_user_text_len"`
		MaxSellingPointsLen int32            `json:"max_selling_points_len"`
		PropRequired        bool             `json:"prop_required"` // 短剧的商品图必填
		MaxVideoBytes       int64            `json:"max_video_bytes"` // 视频复刻：源视频体积上限
		MaxVideoSeconds     int32            `json:"max_video_seconds"` // 视频复刻：源视频时长上限
		VideoFormats        []string         `json:"video_formats"` // 视频复刻：支持的格式
		LinkEnabled         bool             `json:"link_enabled"` // 视频复刻：「链接查视频」是否可用
	}
	CreateVideoReq {
		RequestId     string `header:"Idempotency-Key"`
		CopywritingId int64  `json:"copywriting_id,optional"` // 选填：文案来自哪条 AI文案（用于文案的生成历史）
		Kind          string `json:"kind,options=exploreShop|shortDrama|videoRemake"`
		UserText      string `json:"user_text,optional"` // 探店：视频文案；短剧：短剧主题；视频复刻不用
		SellingPoints string `json:"selling_points,optional"` // 短剧：商品卖点
		ShopProfileId int64  `json:"shop_profile_id,optional"` // 选填：关联店铺档案
		// 出镜人物图（选填）：来源同动作迁移 / 数字人口播
		PortraitSource string `json:"portrait_source,optional,options=|UPLOAD|PUBLIC|AI"`
		ImageUrl       string `json:"image_url,optional"`
		PublicId       int64  `json:"public_id,optional"`
		PortraitId     int64  `json:"portrait_id,optional"`
		ImageIndex     int32  `json:"image_index,optional"`
		// 素材图（直传后的地址）：探店 门店图/店内图/道具图；短剧 环境图/商品图（商品图必填）
		Env1Url  string `json:"env1_url,optional"`
		Env2Url  string `json:"env2_url,optional"`
		PropUrl  string `json:"prop_url,optional"`
		Duration int32  `json:"duration,optional"`
		Size     string `json:"size,optional"`
		Model    string `json:"model,optional"`
		// 爆款视频复刻
		Source   string `json:"source,optional,options=|upload|link"` // upload 上传本地视频 / link 粘贴链接
		VideoUrl string `json:"video_url,optional"` // upload：直传后的视频地址
		Link     string `json:"link,optional"` // link：用户粘贴的分享链接
	}
	VideoCreation {
		Id             int64  `json:"id"`
		Kind           string `json:"kind"`
		UserText       string `json:"user_text"`
		SellingPoints  string `json:"selling_points"`
		ShopProfileId  int64  `json:"shop_profile_id"`
		CharUrl        string `json:"char_url"`
		Env1Url        string `json:"env1_url"`
		Env2Url        string `json:"env2_url"`
		PropUrl        string `json:"prop_url"`
		Duration       int32  `json:"duration"`
		Size           string `json:"size"`
		Model          string `json:"model"`
		Script         string `json:"script"` // 剧本 JSON 原文（状态 1 起有值）
		VideoUrl       string `json:"video_url"`
		Status         int32  `json:"status"` // 0-构思中 1-待确认 2-生成中 3-已完成 4-失败
		Source         string `json:"source"` // 视频复刻：upload / link
		SourceUrl      string `json:"source_url"` // 视频复刻：用户粘贴的原链接
		SourceVideoUrl string `json:"source_video_url"` // 视频复刻：待解析的视频地址
		Title          string `json:"title"` // 视频复刻：原视频标题
		CoverUrl       string `json:"cover_url"` // 视频复刻：原视频封面
		FailReason     string `json:"fail_reason"`
		CreateTime     int64  `json:"create_time"`
	}
	ListVideoCreationsReq {
		Kind     string `form:"kind,optional,options=|exploreShop|shortDrama|videoRemake"`
		Status   int32  `form:"status,optional,default=-1"`
		Page     int64  `form:"page,optional,default=1"`
		PageSize int64  `form:"page_size,optional,default=20"`
	}
	VideoCreationListResp {
		List  []VideoCreation `json:"list"`
		Total int64           `json:"total"`
	}
)

@server (
	prefix:     /api/v1/local-life
	middleware: Auth
	group:      videogen
	tags:       "探店视频 / 带货短剧"
	authType:   auth
)
service gateway-api {
	@doc "表单配置（模型/时长/比例/字数上限）"
	@handler videoOptions
	get /video-creations/options (VideoOptionsReq) returns (VideoOptionsResp)

	@doc "提交表单，开始构思剧本（探店 72 / 短剧 87）"
	@handler createVideo
	post /video-creations (CreateVideoReq) returns (VideoCreation)

	@doc "详情（构思中、生成中都轮询这个）"
	@handler getVideo
	get /video-creations/:id (IdPath) returns (VideoCreation)

	@doc "规划剧本页的「重新生成」：重新构思"
	@handler replanVideo
	post /video-creations/:id/replan (IdPath) returns (VideoCreation)

	@doc "确认剧本，开始生成视频（探店 73 / 短剧 88 / 视频复刻 71）"
	@handler generateVideo
	post /video-creations/:id/generate (GenerateVideoReq) returns (VideoCreation)

	@doc "列表"
	@handler listVideos
	get /video-creations (ListVideoCreationsReq) returns (VideoCreationListResp)

	@doc "删除"
	@handler removeVideo
	delete /video-creations/:id (IdPath) returns (EmptyResp)
}

// ---------------- 登录（前端先向联盟换临时 token，再拿它来换我们的令牌）----------------
type (
	LoginReq {
		Token         string `json:"token,optional"` // Java 口径：联盟的临时 token（同 AIGC 的 /api/v1/auth/union-token-login）
		TempToken     string `json:"temp_token,optional"` // 旧字段，仍接受：同一个临时 token
		Authorization string `header:"Authorization,optional"` // 也可以放在这里：Bearer <临时token>
	}
	LoginUser {
		Id       int64  `json:"id"` // 本服务的用户 id
		Nickname string `json:"nickname"`
		Avatar   string `json:"avatar"`
		Phone    string `json:"phone"` // 脱敏，如 130****7881
	}
	LoginResp {
		Token     string `json:"token"` // 之后所有接口带 Authorization: Bearer <token>
		ExpiresAt int64  `json:"expires_at"` // 过期时间（unix 毫秒）
		// RefreshToken / RefreshExpiresAt 仅在与 AIGC 服务共用会话时返回（否则为空 / 0）。
		// 刷新走 AIGC 那边的 POST /api/v1/auth/refresh，我们这边不用再实现。
		RefreshToken     string    `json:"refresh_token,optional"`
		RefreshExpiresAt int64     `json:"refresh_expires_at,optional"`
		User             LoginUser `json:"user"`
		// 以下与 Java 的 LoginRespVO 字段一致（camelCase、秒），旧字段保留，值相同
		AccessToken      string `json:"accessToken,optional"`
		ExpiresIn        int64  `json:"expiresIn,optional"`
		RefreshTokenJava string `json:"refreshToken,optional"`
		RefreshExpiresIn int64  `json:"refreshExpiresIn,optional"`
		UserId           int64  `json:"userId,optional"`
		Username         string `json:"username,optional"`
		Nickname         string `json:"nickname,optional"`
	}
)

@server (
	prefix: /api/v1/local-life
	group:  auth
	tags:   "登录"
)
service gateway-api {
	@doc "【已弃用，仅供旧版本使用】用联盟的临时 token 换令牌。新版本请直接调用 AIGC 的 POST /api/v1/auth/union-token-login（同一个临时 token，同一套响应与错误码）。本接口在下线日期前保留，行为与之一致。"
	@handler login
	post /auth/login (LoginReq) returns (LoginResp)
}

@server (
	prefix:     /api/v1/local-life
	middleware: Auth
	group:      auth
	tags:       "登录"
	authType:   auth
)
service gateway-api {
	@doc "当前登录用户"
	@handler me
	get /auth/me returns (LoginUser)
}

// ---------------- studio：商拍换装 / 姿态复刻 / 图片生成（/api/v1/studio，nginx 单独转发到本网关）----------------
type (
	StudioGarmentImage {
		Url   string `json:"url"` // 只收 http(s) 地址；blob: 表示还没上传完，会被拒绝
		Role  string `json:"role,optional"` // 单品中文名（上衣 / 下装 / 连衣裙 …）或「整套」
		Angle string `json:"angle,optional"` // front / back / side / detail / flat / unknown；空按 unknown
	}
	StudioTryonSubmitReq {
		RequestId      string               `header:"Idempotency-Key"`
		WorkspaceId    int64                `json:"workspace_id,optional"` // 工作空间；不传=个人空间
		ModelImageUrls []string             `json:"model_image_urls"` // 模特图 1–9 张，每张一位模特
		GarmentImages  []StudioGarmentImage `json:"garment_images,optional"` // 服装图 ≤9 张，每件 ≤6 张
		Items          []string             `json:"items"` // 单品 1–3 件：top/bottom/dress/outer/shoes/accessory/bra/panties（裙↔上衣/下装、文胸↔上衣/裙、内裤↔下装/裙 互斥）
		SetMode        string               `json:"set_mode,optional"` // one / two（1 件也传）；空按 one
		Lengths        map[string]string    `json:"lengths,optional"` // {单品: 长度}，只认 items 里有的键
		Sleeves        map[string]string    `json:"sleeves,optional"` // {单品: 袖长}，只认 items 里有的键
		Fabric         string               `json:"fabric,optional"` // 按件写：「上衣：真丝；鞋子：皮革」
		Prompt         string               `json:"prompt,optional"` // 补充说明，≤3000 字
		Model          string               `json:"model,optional"` // 通用 / GPT / Banana / Seedream；空=通用
		Resolution     string               `json:"resolution,optional"` // 1k / 2k / 4k（大小写均可）；空=1k
		AspectRatio    string               `json:"aspect_ratio,optional"` // 空=3:4
		CountPerModel  int32                `json:"count_per_model"` // 每位模特张数 1–9
		ClothImageUrl  string               `json:"cloth_image_url,optional"` // 旧版兼容位，新前端不要传
	}
	StudioPoseSubmitReq {
		RequestId      string            `header:"Idempotency-Key"`
		WorkspaceId    int64             `json:"workspace_id,optional"`
		SourceImageUrl string            `json:"source_image_url"` // 人物图（图 1）
		PoseImageUrls  []string          `json:"pose_image_urls"` // 姿势图 1–9 张，每张一个任务
		GlobalPrompt   string            `json:"global_prompt,optional"` // 全局补充说明，≤3000 字
		PosePrompts    map[string]string `json:"pose_prompts,optional"` // 单张补充说明 {"0": "…", "2": "…"}，键为姿势下标（从 0 起）
		Model          string            `json:"model,optional"`
		Resolution     string            `json:"resolution,optional"`
		AspectRatio    string            `json:"aspect_ratio,optional"` // 空=3:4
		// 多人配对（可选，来自 /pose/preview 的确认结果）：传 mappings 时必须带 source_person_count（预览时原图人数）
		SourcePersonCount int32               `json:"source_person_count,optional"`
		Mappings          []StudioPoseMapping `json:"mappings,optional"` // 每张姿势图一条；不传的按默认配对（左→左、右→右）
	}
	// 一张姿势图的配对：mapping[i] = 原图第 i 位人物（左→右）学姿势图第几位人物（左→右，从 0 起），-1 = 保持原姿势。
	// 校验：len(mapping) = source_person_count；值在 [-1, pose_person_count-1]；非负值不重复；至少一个非负值
	StudioPoseMapping {
		PoseIndex       int32   `json:"pose_index"` // 姿势图下标（从 0 起）
		Mapping         []int32 `json:"mapping"`
		PosePersonCount int32   `json:"pose_person_count"` // 预览时该姿势图的人数
	}
	// 人物配对预览：只读、不计费；与提交同一套图片地址校验
	StudioPosePreviewReq {
		SourceImageUrl string   `json:"source_image_url"` // 人物图（图 1）
		PoseImageUrls  []string `json:"pose_image_urls"` // 姿势图 1–9 张
	}
	StudioPosePreviewPerson {
		Label     string `json:"label"` // P1…P4，按画面左→右
		Position  string `json:"position"` // 画面左侧 / 画面中间 / 画面右侧 …
		Primary   bool   `json:"primary"`
		GenderAge string `json:"gender_age"` // 原图人物有；姿势图人物为空串
		Summary   string `json:"summary"` // 原图：服装摘要；姿势图：动作剪影
	}
	StudioPosePreviewImage {
		PersonCount     int32                     `json:"person_count"`
		People          []StudioPosePreviewPerson `json:"people"`
		Group           string                    `json:"group"` // 整组站位
		Interaction     string                    `json:"interaction"` // 身体接触；没有为「无」
		PeopleTruncated bool                      `json:"people_truncated"` // 超过 4 人，只分析了前 4 位
	}
	StudioPosePreviewItem {
		PoseIndex      int32                   `json:"pose_index"`
		Pose           *StudioPosePreviewImage `json:"pose"` // 该姿势图分析失败时为 null
		DefaultMapping []int32                 `json:"default_mapping"` // 默认配对（长度 = 原图人数）；原图单人时为 []
		Error          string                  `json:"error"` // 该姿势图失败原因；成功为空串
	}
	StudioPosePreviewResp {
		Source         StudioPosePreviewImage  `json:"source"`
		Poses          []StudioPosePreviewItem `json:"poses"` // 每张姿势图一条（顺序同 pose_image_urls）；原图单人时也逐张给 pose.person_count，用于提示多出的人物会被忽略
		MappingEnabled bool                    `json:"mapping_enabled"` // 原图 ≥2 人：显示配对 / 反转配对
	}
	StudioImageGenSubmitReq {
		RequestId     string   `header:"Idempotency-Key"`
		WorkspaceId   int64    `json:"workspace_id,optional"`
		Prompt        string   `json:"prompt"` // ≤3000 字
		ImageUrls     []string `json:"image_urls,optional"` // 参考图 ≤9 张
		Model         string   `json:"model,optional"`
		Resolution    string   `json:"resolution,optional"`
		AspectRatio   string   `json:"aspect_ratio,optional"` // 空=1:1
		Count         int32    `json:"count"` // 1–9，一张一个任务
		RewritePrompt bool     `json:"rewrite_prompt,optional"` // 先润色提示词
	}
	StudioSubmitResp {
		BatchId         int64    `json:"batch_id"`
		TaskTotal       int32    `json:"task_total"`
		EstimatedPoints int64    `json:"estimated_points"`
		TaskIds         []string `json:"task_ids"`
		Replayed        bool     `json:"replayed"` // 同一 Idempotency-Key 重复提交：返回的是原批次
		Warnings        []string `json:"warnings"` // 参数归一告警（如 Seedream 4K → 2K，按归一后的档位生成并计费）；没有为 []
	}
	// 提交前报价：请求体与对应的提交接口同构（可直接发提交体，其余字段忽略），字段全部选填，不要 Idempotency-Key
	StudioTryonQuoteReq {
		ModelImageUrls []string `json:"model_image_urls,optional"` // 只用张数：任务数 = 模特图数 × count_per_model
		CountPerModel  int32    `json:"count_per_model,optional"`
		Model          string   `json:"model,optional"` // 通用 / GPT / Banana / Seedream；空=通用
		Resolution     string   `json:"resolution,optional"` // 1k / 2k / 4k；空=1k
		AspectRatio    string   `json:"aspect_ratio,optional"` // 空=按模特图自动
	}
	StudioPoseQuoteReq {
		PoseImageUrls []string `json:"pose_image_urls,optional"` // 只用张数：任务数 = 姿势图数
		Model         string   `json:"model,optional"`
		Resolution    string   `json:"resolution,optional"`
		AspectRatio   string   `json:"aspect_ratio,optional"` // 空=按人物图自动
	}
	StudioImageGenQuoteReq {
		Count       int32  `json:"count,optional"` // 任务数 = count
		Model       string `json:"model,optional"`
		Resolution  string `json:"resolution,optional"`
		AspectRatio string `json:"aspect_ratio,optional"` // 空=1:1
	}
	StudioQuoteResp {
		Available   bool     `json:"available"` // 能否报出价；false 时点数为 0，原因见 reason
		Points      int64    `json:"points"` // 本次提交预计冻结点数 = unit_points × task_total（与提交回的 estimated_points 同口径）
		UnitPoints  int64    `json:"unit_points"` // 每张点数
		PriceUnit   string   `json:"price_unit"` // PER_IMAGE
		TaskTotal   int32    `json:"task_total"` // 计价张数；0 = 素材还没传够，只回单价
		Resolution  string   `json:"resolution"` // 计价分辨率（已按模型档归一，如 Seedream 4k → 2k）
		BillingMode string   `json:"billing_mode"` // on 真扣 / shadow 只算价不扣 / off 不计费（点数为 0）
		Charged     bool     `json:"charged"` // 提交是否真的冻结扣点（仅 billing_mode=on）
		Reason      string   `json:"reason"` // available=false 的原因；可用时为空
		Warnings    []string `json:"warnings"` // 参数归一告警（同提交）；没有为 []
	}
	StudioBatch {
		Id              int64  `json:"id"`
		Kind            string `json:"kind"` // tryon / pose / imagegen
		Status          int32  `json:"status"` // 0-排队 1-切图中 2-反推中 3-生图中 4-全部成功 5-全部失败 6-部分成功 7-已取消
		Payload         string `json:"payload"` // 提交时的全量字段（JSON 文本），用于回填表单
		TaskTotal       int32  `json:"task_total"`
		TaskDone        int32  `json:"task_done"`
		TaskFailed      int32  `json:"task_failed"`
		EstimatedPoints int64  `json:"estimated_points"`
		ErrorReason     string `json:"error_reason"`
		CoverUrl        string `json:"cover_url"`
		CreatedAt       int64  `json:"created_at"` // unix 毫秒
		UpdatedAt       int64  `json:"updated_at"`
	}
	StudioTask {
		Id            int64  `json:"id"`
		TaskId        string `json:"task_id"`
		BatchId       int64  `json:"batch_id"`
		Kind          string `json:"kind"`
		ModelIndex    int32  `json:"model_index"`
		ShotIndex     int32  `json:"shot_index"`
		PoseIndex     int32  `json:"pose_index"`
		Status        int32  `json:"status"` // 0-排队 1-生成中 2-成功 3-失败 4-已取消
		Progress      int32  `json:"progress"` // 0–100（估算）
		ResultUrl     string `json:"result_url"`
		ResultWidth   int32  `json:"result_width"`
		ResultHeight  int32  `json:"result_height"`
		ErrorReason   string `json:"error_reason"`
		PromptSummary string `json:"prompt_summary"`
		CreatedAt     int64  `json:"created_at"`
		StartedAt     int64  `json:"started_at"` // 0=未开始
		FinishedAt    int64  `json:"finished_at"` // 0=未结束
	}
	StudioBatchDetail {
		Batch StudioBatch  `json:"batch"`
		Tasks []StudioTask `json:"tasks"`
	}
	StudioTaskPath {
		TaskId string `path:"task_id"`
	}
	StudioHistoryReq {
		Kind   string `form:"kind,optional,options=|tryon|pose|imagegen"`
		Cursor string `form:"cursor,optional"` // 上一页的 next_cursor；空=第一页
		Limit  int32  `form:"limit,optional,default=20"` // 上限 50
	}
	StudioHistoryResp {
		List       []StudioBatchDetail `json:"list"`
		NextCursor string              `json:"next_cursor"` // 空=没有下一页
	}
	StudioCancelResp {
		Batch         StudioBatch `json:"batch"`
		CanceledTasks int32       `json:"canceled_tasks"`
	}
)

@server (
	prefix:     /api/v1/studio
	middleware: Auth
	group:      studio
	tags:       "商拍换装 / 姿态复刻 / 图片生成"
	authType:   auth
)
service gateway-api {
	@doc "商拍换装整批提交（模特 × 每位张数，服务端拆任务）；必须带 Idempotency-Key"
	@handler submitTryon
	post /tryon/submit (StudioTryonSubmitReq) returns (StudioSubmitResp)

	@doc "姿态复刻整批提交（人物 1 张 + 姿势 1–9 张）；必须带 Idempotency-Key"
	@handler submitPose
	post /pose/submit (StudioPoseSubmitReq) returns (StudioSubmitResp)

	@doc "图片生成（count 张拆任务）；必须带 Idempotency-Key"
	@handler submitImageGen
	post /image-generate/submit (StudioImageGenSubmitReq) returns (StudioSubmitResp)

	@doc "商拍换装提交前报价（只读，不冻结）：请求体同提交，返回本次提交预计冻结的点数"
	@handler quoteTryon
	post /tryon/quote (StudioTryonQuoteReq) returns (StudioQuoteResp)

	@doc "姿态复刻提交前报价（只读，不冻结）"
	@handler quotePose
	post /pose/quote (StudioPoseQuoteReq) returns (StudioQuoteResp)

	@doc "图片生成提交前报价（只读，不冻结）"
	@handler quoteImageGen
	post /image-generate/quote (StudioImageGenQuoteReq) returns (StudioQuoteResp)

	@doc "批次详情 + 子任务（生成中轮询此接口）"
	@handler getBatch
	get /batches/:id (IdPath) returns (StudioBatchDetail)

	@doc "单个子任务"
	@handler getTask
	get /tasks/:task_id (StudioTaskPath) returns (StudioTask)

	@doc "重试单个失败子任务（仅本人、任务失败且批次为全部失败 / 部分成功）：只重跑这张图的生图一步（沿用已存提示词，不再反推），按原入口重新冻结 1 张点数；返回批次详情（同 GET /batches/:id），之后照常轮询批次。重复点击幂等"
	@handler retryTask
	post /tasks/:task_id/retry (StudioTaskPath) returns (StudioBatchDetail)

	@doc "历史（游标分页），含提交快照供回填"
	@handler history
	get /history (StudioHistoryReq) returns (StudioHistoryResp)

	@doc "取消批次：停止跟踪，未开始的任务退款"
	@handler cancelBatch
	post /batches/:id/cancel (IdPath) returns (StudioCancelResp)

	@doc "删除批次（生成中不能删）"
	@handler deleteBatch
	delete /batches/:id (IdPath) returns (EmptyResp)
}

// 人物配对预览要读原图 + 每张姿势图（单次读图 60–140s），单独放宽路由超时（nginx proxy_read_timeout 为 300s）
@server (
	prefix:     /api/v1/studio
	middleware: Auth
	group:      studio
	tags:       "商拍换装 / 姿态复刻 / 图片生成"
	authType:   auth
	timeout:    250s
)
service gateway-api {
	@doc "姿态复刻多人配对预览（只读、不计费）：返回原图与每张姿势图的人数、人物站位与默认配对；原图 ≥2 人时前端据此让用户确认 / 反转配对，再把 mappings 随提交带回"
	@handler previewPose
	post /pose/preview (StudioPosePreviewReq) returns (StudioPosePreviewResp)
}

// ---------------- assetlib：资产库增强（/api/v1/asset-library，nginx 单独转发到本网关）----------------
// Java 素材表 afv_asset 只读 + Go 旁表（分类 / 收藏 / 标签 / 版本 / 关系）。越权与不存在一律 4001。
type (
	AssetLibMetadata {
		Industry string `json:"industry,optional"` // 行业；PATCH 时缺省 = 空
		Style    string `json:"style,optional"` // 风格
		Shot     string `json:"shot,optional"` // 镜头
		Color    string `json:"color,optional"` // 色彩
	}
	AssetLibProvenance {
		RunId      string `json:"run_id"`
		WorkflowId string `json:"workflow_id"`
		NodeId     string `json:"node_id"`
		Operator   string `json:"operator"`
		Model      string `json:"model"`
		Params     string `json:"params"` // JSON 文本；空=没有
		CreatedAt  int64  `json:"created_at"`
	}
	AssetLibVersion {
		Id        int64  `json:"id"`
		VersionNo int32  `json:"version_no"` // 同资产从 1 起
		Image     string `json:"image"`
		Prompt    string `json:"prompt"`
		Model     string `json:"model"`
		Params    string `json:"params"` // JSON 文本
		CreatedAt int64  `json:"created_at"`
	}
	AssetLibAsset {
		Id               int64              `json:"id"`
		Kind             string             `json:"kind"` // model / scene / makeup / hair / accessory；空=未分类
		Title            string             `json:"title"`
		Prompt           string             `json:"prompt"`
		Image            string             `json:"image"` // 当前版本图 > 原图（视频为封面）
		Media            string             `json:"media"` // image / video
		VideoUrl         string             `json:"video_url"`
		Source           string             `json:"source"` // upload / generated / official
		Tags             []string           `json:"tags"`
		CreatedAt        int64              `json:"created_at"`
		Favorite         bool               `json:"favorite"`
		License          string             `json:"license"` // cleared / internal / unknown；空=未设置
		Metadata         AssetLibMetadata   `json:"metadata"`
		Provenance       AssetLibProvenance `json:"provenance"`
		Versions         []AssetLibVersion  `json:"versions"` // 仅详情带
		CurrentVersionId int64              `json:"current_version_id"` // 0=原图
		RelatedIds       []int64            `json:"related_ids"` // 仅详情带
		EntryCode        string             `json:"entry_code"`
		Width            int32              `json:"width"`
		Height           int32              `json:"height"`
	}
	AssetLibListReq {
		Kind         string `form:"kind,optional,options=|model|scene|makeup|hair|accessory|uncategorized|viral_video|video_remake|promo_video|digital_human|digital_human_talk|store_visit|promo_drama|motion_transfer|canvas_video|video_other"`
		Source       string `form:"source,optional,options=|input|generated|official|upload"` // input = official + upload
		Media        string `form:"media,optional,options=|image|video"`
		Tag          string `form:"tag,optional"` // 标签名
		FavoriteOnly bool   `form:"favorite_only,optional"`
		Q            string `form:"q,optional"` // 标题 / 提示词模糊
		Page         int64  `form:"page,optional,default=1"`
		PageSize     int64  `form:"page_size,optional,default=20"` // 上限 100
		KindGroup    string `form:"kind_group,optional,options=|image|video"` // 大类：image = 5 个图片 kind；video = 视频 kind
		AspectRatio  string `form:"aspect_ratio,optional"` // 比例，如 1:1 / 3:4 / 9:16
		EntryCodes   string `form:"entry_codes,optional"` // 入口码，逗号分隔（每项 [A-Za-z0-9_.-]{1,64}，最多 200 个），按 entry_code IN (...)
	}
	AssetLibListResp {
		Items []AssetLibAsset `json:"items"`
		Total int64           `json:"total"`
	}
	AssetLibCategoriesReq {
		Source string `form:"source,optional,options=|input|generated|official|upload"`
		Media  string `form:"media,optional,options=|image|video"`
	}
	AssetLibCategory {
		Key   string `json:"key"` // all / model / scene / makeup / hair / accessory / uncategorized
		Label string `json:"label"`
		Count int64  `json:"count"`
	}
	AssetLibCategoriesResp {
		Items []AssetLibCategory `json:"items"`
	}
	AssetLibGetReq {
		Id          int64 `path:"id"`
		VersionPage int64 `form:"version_page,optional,default=1"`
		RelatedPage int64 `form:"related_page,optional,default=1"`
		ResultPage  int64 `form:"result_page,optional,default=1"`
		PageSize    int64 `form:"page_size,optional,default=6"` // 三组共用，上限 50
	}
	AssetLibVersionPage {
		Items []AssetLibVersion `json:"items"`
		Total int64             `json:"total"`
	}
	AssetLibAssetPage {
		Items []AssetLibAsset `json:"items"`
		Total int64           `json:"total"`
	}
	AssetLibDetail {
		Asset            AssetLibAsset       `json:"asset"`
		Versions         AssetLibVersionPage `json:"versions"`
		Related          AssetLibAssetPage   `json:"related"` // reference（双向）+ 本资产的生成来源
		GeneratedResults AssetLibAssetPage   `json:"generated_results"` // 由本资产生成的资产
	}
	AssetLibUpdateReq {
		Id               int64             `path:"id"`
		Title            *string           `json:"title,optional"` // ≤100 字
		Kind             *string           `json:"kind,optional"` // 空串=改回未分类
		Favorite         *bool             `json:"favorite,optional"`
		Tags             *[]string         `json:"tags,optional"` // 整组替换，≤10 个；字典里没有的自动建
		Metadata         *AssetLibMetadata `json:"metadata,optional"` // 整体替换
		CurrentVersionId *int64            `json:"current_version_id,optional"` // 0=回到原图
		License          *string           `json:"license,optional"` // cleared / internal / unknown / 空
	}
	AssetLibAddVersionReq {
		Id       int64  `path:"id"`
		ImageUrl string `json:"image_url"`
		Prompt   string `json:"prompt,optional"`
		Model    string `json:"model,optional"`
		Params   string `json:"params,optional"` // JSON 文本
		ImageRid string `json:"image_rid,optional"`
	}
	AssetLibRelationReq {
		Id             int64  `path:"id"`
		RelatedAssetId int64  `json:"related_asset_id"`
		RelationType   string `json:"relation_type,options=reference|generated_from|version_of"`
	}
	AssetLibRelationDelReq {
		Id             int64  `path:"id"`
		RelatedAssetId int64  `form:"related_asset_id"`
		RelationType   string `form:"relation_type,options=reference|generated_from|version_of"`
	}
	AssetLibTag {
		Id         int64  `json:"id"`
		Name       string `json:"name"`
		AssetCount int64  `json:"asset_count"`
		CreatedAt  int64  `json:"created_at"`
	}
	AssetLibTagListResp {
		Items         []AssetLibTag `json:"items"`
		UntaggedCount int64         `json:"untagged_count"` // 没挂任何标签的资产数（「未分类」计数，口径同列表）
	}
	AssetLibTagCreateReq {
		Name string `json:"name"` // ≤20 字，每用户 ≤200 个
	}
	AssetLibTagRenameReq {
		Id   int64  `path:"id"`
		Name string `json:"name"`
	}
	AssetLibBatchTagReq {
		AssetIds []int64 `json:"asset_ids"` // ≤100
		TagIds   []int64 `json:"tag_ids"` // ≤10
	}
	AssetLibBatchTagResp {
		Added int64 `json:"added"` // 新增的关联条数
	}
)

@server (
	prefix:     /api/v1/asset-library
	middleware: Auth
	group:      assetlib
	tags:       "资产库增强"
	authType:   auth
)
service gateway-api {
	@doc "资产列表（kind / kind_group / 入口码 / source / media / 比例 / tag / 收藏 / 关键字，page 分页）"
	@handler listAssets
	get /assets (AssetLibListReq) returns (AssetLibListResp)

	@doc "分类条计数：all + 5 个 kind + uncategorized，随 source / media"
	@handler categories
	get /assets/categories (AssetLibCategoriesReq) returns (AssetLibCategoriesResp)

	@doc "批量给资产加标签（追加）"
	@handler batchTag
	post /assets/batch-tag (AssetLibBatchTagReq) returns (AssetLibBatchTagResp)

	@doc "资产详情：版本 / 相关资产 / 生成结果，各自分页默认 6"
	@handler getAsset
	get /assets/:id (AssetLibGetReq) returns (AssetLibDetail)

	@doc "改标题 / 分类 / 收藏 / 标签 / 元数据 / 授权 / 当前版本（只改带了的字段）"
	@handler updateAsset
	patch /assets/:id (AssetLibUpdateReq) returns (AssetLibAsset)

	@doc "追加版本（版本号自增），并设为当前版本"
	@handler addVersion
	post /assets/:id/versions (AssetLibAddVersionReq) returns (AssetLibVersion)

	@doc "建立资产关系"
	@handler addRelation
	post /assets/:id/relations (AssetLibRelationReq) returns (EmptyResp)

	@doc "删除资产关系（reference 两个方向都删）"
	@handler removeRelation
	delete /assets/:id/relations (AssetLibRelationDelReq) returns (EmptyResp)

	@doc "我的标签字典（含每个标签的资产数）"
	@handler listTags
	get /tags returns (AssetLibTagListResp)

	@doc "新建标签"
	@handler createTag
	post /tags (AssetLibTagCreateReq) returns (AssetLibTag)

	@doc "删除标签（同时解除与资产的关联）"
	@handler deleteTag
	delete /tags/:id (IdPath) returns (EmptyResp)

	@doc "重命名标签"
	@handler renameTag
	put /tags/:id (AssetLibTagRenameReq) returns (AssetLibTag)
}

// ---------------- canvas：画布（/api/v1/canvas，nginx 单独转发到本网关；接口文档 docs/api/api-canvas.md）----------------
// snapshot / params 是前端私有 JSON（Vue Flow 快照、工具参数），服务端整段存、只校验；这两个字段由手写 handler 解析请求体。
// CanvasBearer 中间件把 Authorization 原文经 gRPC metadata 透传给 canvas-rpc（调 Java 兼容工具 / 价目时代用户）。
type (
	CanvasIdPath {
		Id string `path:"id"`
	}
	CanvasListReq {
		Page     int32 `form:"page,optional,default=1"`
		PageSize int32 `form:"page_size,optional,default=20"` // 上限 50
	}
	CanvasSummary {
		Id        string `json:"id"` // 画布 id（原型 workflowId）
		Title     string `json:"title"`
		Revision  string `json:"revision"`
		NodeCount int32  `json:"node_count"`
		CoverUrl  string `json:"cover_url"` // 快照里第一张可用图；没有为空串
		CreatedAt int64  `json:"created_at"`
		UpdatedAt int64  `json:"updated_at"`
	}
	CanvasListResp {
		Items []CanvasSummary `json:"items"`
		Total int64           `json:"total"`
	}
	CanvasCreateReq {
		Title       string `json:"title,optional"` // 空 = 未命名画布
		WorkspaceId int64  `json:"workspace_id,optional"`
	}
	CanvasDetail {
		Id        string      `json:"id"`
		Title     string      `json:"title"`
		Revision  string      `json:"revision"` // 下次保存原样带回 if_match_revision
		NodeCount int32       `json:"node_count"`
		CoverUrl  string      `json:"cover_url"`
		CreatedAt int64       `json:"created_at"`
		UpdatedAt int64       `json:"updated_at"`
		Snapshot  interface{} `json:"snapshot"` // {nodes, edges}；运行态（status/progress/candidates/image/video/runId…）已按最近一次 run 回填
	}
	CanvasSaveReq {
		Id              string      `path:"id"`
		Title           *string     `json:"title,optional"` // 不传 = 不改标题
		Snapshot        interface{} `json:"snapshot"` // 整段 {nodes, edges}，≤2MB
		IfMatchRevision string      `json:"if_match_revision,optional"` // 版本不符 → code=4002，data={conflict:"revision", revision, updated_at}
		Force           bool        `json:"force,optional"` // true = 忽略版本强制覆盖
	}
	CanvasSaveResp {
		Revision  string `json:"revision"`
		UpdatedAt int64  `json:"updated_at"`
		NodeCount int32  `json:"node_count"`
		CoverUrl  string `json:"cover_url"`
	}
	CanvasSaveAsReq {
		Id    string `path:"id"`
		Title string `json:"title,optional"` // 空 = 原标题 + 「 - 副本」
	}
	CanvasFromTemplateReq {
		TemplateId  int64  `json:"template_id"`
		Title       string `json:"title,optional"` // 空 = 模板标题
		WorkspaceId int64  `json:"workspace_id,optional"`
	}
	CanvasRunRef {
		Handle         string `json:"handle"` // prompt / image / video / audio（及别名 image1/image2/first/last/garment/models/image-in）
		Index          int32  `json:"index,optional"` // 同 handle 内序号（连线 data.order），1 起
		NodeId         string `json:"node_id,optional"`
		Text           string `json:"text,optional"`
		Image          string `json:"image,optional"`
		Video          string `json:"video,optional"`
		Audio          string `json:"audio,optional"`
		AssetId        string `json:"asset_id,optional"`
		MediaId        string `json:"media_id,optional"`
		SourceHandle   string `json:"source_handle,optional"` // image-out / candidate-N …
		CandidateIndex *int32 `json:"candidate_index,optional"` // 引用上游第几个候选（0 起），服务端以记录的候选为准
		Mime           string `json:"mime,optional"`
	}
	CanvasRunReq {
		Id         string         `path:"id"`
		NodeId     string         `path:"node_id"`
		Key        string         `header:"Idempotency-Key,optional"` // = run_id
		RunId      string         `json:"run_id,optional"`
		Kind       string         `json:"kind"` // image / video / tool
		Model      string         `json:"model,optional"`
		ModelId    string         `json:"model_id,optional"`
		Prompt     string         `json:"prompt,optional"`
		References []CanvasRunRef `json:"references,optional"`
		Ratio      string         `json:"ratio,optional"`
		Size       string         `json:"size,optional"`
		Quality    string         `json:"quality,optional"` // low / medium / high（低/中/高 也收）
		Duration   string         `json:"duration,optional"` // 视频 4s / 6s / 8s
		Sound      bool           `json:"sound,optional"`
		Count      int32          `json:"count,optional"` // 1–4；视频固定 1
		Cfg        float64        `json:"cfg,optional"`
		Tool       string         `json:"tool,optional"` // crop / upscale / outpaint / i2p / mask / tryon
		Params     interface{}    `json:"params,optional"` // 工具参数（见 api-canvas.md 3.2）
	}
	CanvasRunResp {
		RequestId string   `json:"request_id"` // 轮询 / 取消用
		RunId     string   `json:"run_id"`
		Status    string   `json:"status"`
		Replayed  bool     `json:"replayed"`
		Credits   int64    `json:"credits"` // 本 run 冻结的点数（Java / studio 工具由对方计费，为 0）
		Warnings  []string `json:"warnings"` // 参数归一告警（如 Seedream 4K → 2K，按归一后的档位生成并计费）；没有为 []
	}
	CanvasCandidate {
		Url    string `json:"url"`
		Width  int32  `json:"width"`
		Height int32  `json:"height"`
	}
	CanvasRunResult {
		RequestId      string            `json:"request_id"`
		RunId          string            `json:"run_id"`
		CanvasId       string            `json:"canvas_id"`
		NodeId         string            `json:"node_id"`
		Kind           string            `json:"kind"` // image / video / tool_crop / tool_upscale / tool_outpaint / tool_inpaint / tool_i2p / tool_tryon
		Status         string            `json:"status"` // submitting / queued / running / succeeded / failed / cancelled
		Progress       int32             `json:"progress"`
		Model          string            `json:"model"`
		Candidates     []CanvasCandidate `json:"candidates"`
		SelectedIndex  int32             `json:"selected_index"`
		VideoUrl       string            `json:"video_url"`
		Text           string            `json:"text"` // 反推提示词结果
		Credits        int64             `json:"credits"`
		RequestedCount int32             `json:"requested_count"`
		Error          string            `json:"error"`
		ErrorCode      string            `json:"error_code"`
		Retryable      bool              `json:"retryable"`
		CreatedAt      int64             `json:"created_at"`
		FinishedAt     int64             `json:"finished_at"`
	}
	CanvasRunPath {
		Id int64 `path:"id"`
	}
	CanvasCancelResp {
		RequestId string `json:"request_id"`
		Status    string `json:"status"`
	}
	CanvasRunsReq {
		Id     string `path:"id"`
		NodeId string `form:"node_id,optional"`
		Limit  int32  `form:"limit,optional,default=50"`
	}
	CanvasRunsResp {
		Items []CanvasRunResult `json:"items"`
	}
	CanvasSelectCandidateReq {
		Id     string `path:"id"`
		NodeId string `path:"node_id"`
		RunId  string `json:"run_id"` // 该节点某次成功 run 的 run_id
		Index  int32  `json:"index"` // 候选下标（0 起）
	}
	CanvasPrice {
		Size     string `json:"size,omitempty"`
		Duration string `json:"duration,omitempty"`
		Points   int64  `json:"points"`
	}
	CanvasCapabilities {
		Quality  bool `json:"quality"`
		Count    bool `json:"count"`
		Duration bool `json:"duration"`
		Sound    bool `json:"sound"`
	}
	CanvasCatalogModel {
		Model              string             `json:"model"`
		ModelId            string             `json:"model_id"`
		Badge              string             `json:"badge"`
		MaxImageRefs       int32              `json:"max_image_refs"` // gateway 模型组 feature_limits 为准
		MaxReferenceVideos int32              `json:"max_reference_videos"`
		Ratios             []string           `json:"ratios"`
		Sizes              []string           `json:"sizes"`
		Qualities          []string           `json:"qualities"`
		Durations          []string           `json:"durations"`
		Sound              bool               `json:"sound"`
		CountMax           int32              `json:"count_max"`
		Capabilities       CanvasCapabilities `json:"capabilities"`
		Prices             []CanvasPrice      `json:"prices"`
		Ready              bool               `json:"ready"`
	}
	CanvasCatalogTool {
		Tool    string   `json:"tool"`
		Label   string   `json:"label"`
		Billing string   `json:"billing"` // free / java / gateway / studio
		Scales  []int32  `json:"scales,omitempty"`
		Ratios  []string `json:"ratios,omitempty"`
		Ready   bool     `json:"ready"`
	}
	CanvasCatalogResp {
		ImageModels      []CanvasCatalogModel `json:"image_models"`
		VideoModels      []CanvasCatalogModel `json:"video_models"`
		Tools            []CanvasCatalogTool  `json:"tools"`
		JavaImageConfigs interface{}          `json:"java_image_configs"` // Java /api/v1/features/image-model-configs 原样透传（按用户报价）；取不到为 null
		JavaVideoConfigs interface{}          `json:"java_video_configs"`
	}
	CanvasTemplateListReq {
		Scope string `form:"scope,optional,default=official,options=official|user|all"`
	}
	CanvasTemplate {
		Id          int64       `json:"id"`
		Scope       string      `json:"scope"` // official / user
		Title       string      `json:"title"`
		Description string      `json:"description"`
		CoverUrl    string      `json:"cover_url"`
		NodeCount   int32       `json:"node_count"`
		EdgeCount   int32       `json:"edge_count"`
		Snapshot    interface{} `json:"snapshot"`
		CreatedAt   int64       `json:"created_at"`
	}
	CanvasTemplateListResp {
		Items []CanvasTemplate `json:"items"`
	}
	CanvasTemplateCreateReq {
		CanvasId    string `json:"canvas_id"`
		Title       string `json:"title,optional"`
		Description string `json:"description,optional"`
	}
)

@server (
	prefix:     /api/v1/canvas
	middleware: Auth,CanvasBearer
	group:      canvas
	tags:       "画布"
	authType:   auth
)
service gateway-api {
	@doc "画布列表（updated_at 倒序）"
	@handler listCanvases
	get /canvases (CanvasListReq) returns (CanvasListResp)

	@doc "新建画布（空快照）"
	@handler createCanvas
	post /canvases (CanvasCreateReq) returns (CanvasDetail)

	@doc "从模板建画布（节点 / 连线 id 重新生成）"
	@handler createFromTemplate
	post /canvases/from-template (CanvasFromTemplateReq) returns (CanvasDetail)

	@doc "取画布：快照 + revision，运行态按最近一次 run 回填"
	@handler getCanvas
	get /canvases/:id (CanvasIdPath) returns (CanvasDetail)

	@doc "保存（乐观锁 if_match_revision，冲突 code=4002 data.conflict=revision；force=true 覆盖）"
	@handler saveCanvas
	put /canvases/:id (CanvasSaveReq) returns (CanvasSaveResp)

	@doc "删除（逻辑删除）"
	@handler deleteCanvas
	delete /canvases/:id (CanvasIdPath) returns (EmptyResp)

	@doc "另存为：复制已保存的快照（运行态剥离）"
	@handler saveAsCanvas
	post /canvases/:id/save-as (CanvasSaveAsReq) returns (CanvasDetail)

	@doc "执行单个节点；必须带 Idempotency-Key（= run_id）"
	@handler runNode
	post /canvases/:id/nodes/:node_id/run (CanvasRunReq) returns (CanvasRunResp)

	@doc "画布的执行记录（新的在前）"
	@handler listRuns
	get /canvases/:id/runs (CanvasRunsReq) returns (CanvasRunsResp)

	@doc "选中候选：写回 run.selected_index，刷新后 selectedCandidate 仍是它"
	@handler selectCandidate
	post /canvases/:id/nodes/:node_id/select-candidate (CanvasSelectCandidateReq) returns (CanvasRunResult)

	@doc "查询一次执行（轮询，1.2s）"
	@handler getRun
	get /runs/:id (CanvasRunPath) returns (CanvasRunResult)

	@doc "取消执行：gateway 退回点数并取消上游、studio 取消批次、Java 工具调 Java 取消接口（由 Java 退款；取消时已成功则交付；无有效登录态时退化为停止跟踪）"
	@handler cancelRun
	post /runs/:id/cancel (CanvasRunPath) returns (CanvasCancelResp)

	@doc "模型 / 参数 / 工具目录（替代前端写死）"
	@handler catalog
	get /catalog returns (CanvasCatalogResp)

	@doc "模板列表（official / user / all）"
	@handler listTemplates
	get /templates (CanvasTemplateListReq) returns (CanvasTemplateListResp)

	@doc "模板详情"
	@handler getTemplate
	get /templates/:id (IdPath) returns (CanvasTemplate)

	@doc "把画布存为我的模板"
	@handler createTemplate
	post /templates (CanvasTemplateCreateReq) returns (CanvasTemplate)

	@doc "删除我的模板（官方模板不可删）"
	@handler deleteTemplate
	delete /templates/:id (IdPath) returns (EmptyResp)
}

// ---------------- promptlib：提示词库（/api/v1/prompt-library，nginx 单独转发到本网关）----------------
type (
	PromptLibItem {
		Id        int64    `json:"id"`
		Title     string   `json:"title"`
		Prompt    string   `json:"prompt"`
		Vertical  string   `json:"vertical"` // ecommerce / general / mine
		Group     string   `json:"group"` // 二级分类英文 key
		Models    []string `json:"models"` // 通用 / GPT / Banana / Seedream
		Tags      []string `json:"tags"`
		Source    string   `json:"source"`
		Owner     string   `json:"owner"` // official / mine
		CreatedAt int64    `json:"created_at"`
		UpdatedAt int64    `json:"updated_at"`
	}
	PromptLibListReq {
		Vertical string `form:"vertical,optional,options=|ecommerce|general|mine"`
		Group    string `form:"group,optional"`
		Model    string `form:"model,optional"`
		Q        string `form:"q,optional"`
		Page     int32  `form:"page,optional,default=1"`
		PageSize int32  `form:"page_size,optional,default=20"`
	}
	PromptLibListResp {
		Items []PromptLibItem `json:"items"`
		Total int64           `json:"total"`
	}
	PromptLibUpsertReq {
		Title  string   `json:"title"` // ≤100 字
		Prompt string   `json:"prompt"` // ≤3000 字
		Models []string `json:"models,optional"` // ≤10，缺省 ["通用"]
		Tags   []string `json:"tags,optional"` // ≤10
		Group  string   `json:"group,optional"` // 忽略：我的提示词固定 mine / favorite
	}
	PromptLibUpdateReq {
		Id     int64    `path:"id"`
		Title  string   `json:"title"`
		Prompt string   `json:"prompt"`
		Models []string `json:"models,optional"`
		Tags   []string `json:"tags,optional"`
		Group  string   `json:"group,optional"`
	}
)

@server (
	prefix:     /api/v1/prompt-library
	middleware: Auth
	group:      promptlib
	tags:       "提示词库"
	authType:   auth
)
service gateway-api {
	@doc "提示词列表：官方（启用）+ 我的"
	@handler listPrompts
	get /prompts (PromptLibListReq) returns (PromptLibListResp)

	@doc "新增我的提示词（每人 ≤500 条）"
	@handler createPrompt
	post /prompts (PromptLibUpsertReq) returns (PromptLibItem)

	@doc "修改我的提示词（官方 4002）"
	@handler updatePrompt
	put /prompts/:id (PromptLibUpdateReq) returns (PromptLibItem)

	@doc "删除我的提示词（官方 4002）"
	@handler deletePrompt
	delete /prompts/:id (IdPath) returns (EmptyResp)
}

