syntax = "v1"

info (
	title:                       "AIGC 本地生活 运营后台接口"
	version:                     "v1"
	description:                 "HTTP 状态码一律 200，用响应里的 code 判断，业务数据在 data 里。提交生成类接口必须带 X-Request-Id（UUID，重试沿用同一个）。完整说明见安装目录 docs/ 下的接口文档。"
	schemes:                     "http,https"
	consumes:                    "application/json"
	produces:                    "application/json"
	wrapCodeMsg:                 true
	bizCodeEnumDescription:      "0-成功<br>1000-服务异常，稍后重试<br>1001-参数错误，直接展示 msg<br>1002-未登录<br>1003-不存在或不属于当前用户<br>1005-状态冲突<br>1006-暂未开放 / 形象未生成完成<br>1007-未同意《AIGC功能使用约定》<br>1008-点数不足（计费未接）"
	securityDefinitionsFromJson: `{"auth":{"type":"apiKey","in":"header","name":"Authorization","description":"Bearer <登录接口返回的 token>；联调也可改填 X-Admin-Id 请求头"}}`
)

type (
	IdPath {
		Id int64 `path:"id"`
	}
	EmptyResp  {}
	Option {
		Id         int64  `json:"id"`
		OptionType string `json:"option_type"`
		Code       string `json:"code"`
		Label      string `json:"label"`
		Value      string `json:"value"`
		SortOrder  int32  `json:"sort_order"`
		Status     int32  `json:"status"`
	}
	OptionListReq {
		OptionType string `form:"option_type,optional,options=CONTENT_TYPE|STYLE|INDUSTRY|WORD_COUNT|PROMPT|BLOCKWORD"`
	}
	OptionListResp {
		List []Option `json:"list"`
	}
	SaveOptionReq {
		Id         int64  `path:"id,optional"`
		OptionType string `json:"option_type,options=CONTENT_TYPE|STYLE|INDUSTRY|WORD_COUNT|PROMPT|BLOCKWORD"`
		Code       string `json:"code"`
		Label      string `json:"label"`
		Value      string `json:"value,optional"`
		SortOrder  int32  `json:"sort_order,optional"`
		Status     int32  `json:"status,options=0|1"`
	}
	ModelResp {
		Id       int64  `json:"id"`
		Name     string `json:"name"`
		Code     string `json:"code"`
		Platform string `json:"platform"`
	}
	CopywritingListReq {
		Page     int64  `form:"page,optional,default=1"`
		PageSize int64  `form:"page_size,optional,default=20"`
		UserId   int64  `form:"user_id,optional"`
		Keyword  string `form:"keyword,optional"`
	}
	ResolveCopywritingReq {
		Id   int64  `path:"id"`
		Note string `json:"note"`
	}
	ResolveCopywritingResp {
		ReservationStatus string `json:"reservation_status"`
		RefundedPoints    int64  `json:"refunded_points"`
	}
	Copywriting {
		Id               int64  `json:"id"`
		Source           string `json:"source"`
		ContentType      string `json:"content_type"`
		ContentTypeLabel string `json:"content_type_label"`
		Title            string `json:"title"`
		Body             string `json:"body"`
		WordCount        int32  `json:"word_count"`
		Status           int32  `json:"status"`
		FailReason       string `json:"fail_reason"`
		CreateTime       int64  `json:"create_time"`
	}
	CopywritingListResp {
		List  []Copywriting `json:"list"`
		Total int64         `json:"total"`
	}
)

// ---------------- 登录（用现有后台账号 afv_admin_user）----------------
type (
	AdminLoginReq {
		Username string `json:"username"`
		Password string `json:"password"`
	}
	AdminInfo {
		Id       int64    `json:"id"`
		Username string   `json:"username"`
		RealName string   `json:"real_name"`
		Roles    []string `json:"roles"` // 角色编码：super_admin / billing_admin / operator
	}
	AdminLoginResp {
		Token     string    `json:"token"` // 之后所有接口带 Authorization: Bearer <token>
		ExpiresAt int64     `json:"expires_at"` // 过期时间（unix 毫秒）
		Admin     AdminInfo `json:"admin"`
	}
)

@server (
	prefix: /api/v1/local-life/admin
	group:  auth
	tags:   "登录"
)
service admin-api {
	@doc "后台登录：用现有后台账号，连错 5 次锁 15 分钟"
	@handler login
	post /auth/login (AdminLoginReq) returns (AdminLoginResp)
}

@server (
	prefix:     /api/v1/local-life/admin
	middleware: AdminAuth
	group:      auth
	tags:       "登录"
	authType:   auth
)
service admin-api {
	@doc "当前登录的管理员"
	@handler me
	get /auth/me returns (AdminInfo)
}

@server (
	prefix:     /api/v1/local-life/admin
	middleware: AdminAuth
	group:      copywriting
	tags:       "AI文案"
	authType:   auth
)
service admin-api {
	@doc "选项列表"
	@handler listOptions
	get /copywriting/options (OptionListReq) returns (OptionListResp)

	@doc "新增选项"
	@handler createOption
	post /copywriting/options (SaveOptionReq) returns (Option)

	@doc "编辑选项"
	@handler updateOption
	put /copywriting/options/:id (SaveOptionReq) returns (Option)

	@doc "删除选项"
	@handler deleteOption
	delete /copywriting/options/:id (IdPath) returns (EmptyResp)

	@doc "当前写作模型（只读）"
	@handler getModel
	get /copywriting/model returns (ModelResp)

	@doc "用户文案列表"
	@handler listCopywriting
	get /copywriting (CopywritingListReq) returns (CopywritingListResp)

	@doc "删除用户文案"
	@handler deleteCopywriting
	delete /copywriting/:id (IdPath) returns (EmptyResp)

	@doc "人工处理卡住的文案：仅限生成中且点数已扣的记录；先把已扣点数全部退回，再标记失败并记录处理说明；返回预留单状态与退回点数"
	@handler resolveCopywriting
	post /copywriting/:id/resolve (ResolveCopywritingReq) returns (ResolveCopywritingResp)
}

// ---------------- AI 数字人 ----------------
type (
	DhOptionListReq {
		OptionType string `form:"option_type,optional,options=AGE|SKIN_TONE|ROLE|VOICE_CATEGORY|PROMPT"`
	}
	DhSaveOptionReq {
		Id         int64  `path:"id,optional"`
		OptionType string `json:"option_type,options=AGE|SKIN_TONE|ROLE|VOICE_CATEGORY|PROMPT"`
		Code       string `json:"code"`
		Label      string `json:"label"`
		Value      string `json:"value,optional"`
		SortOrder  int32  `json:"sort_order,optional"`
		Status     int32  `json:"status,options=0|1"`
	}
	Voice {
		Id         int64    `json:"id"`
		Name       string   `json:"name"`
		Voice      string   `json:"voice"`
		Gender     string   `json:"gender"`
		Style      string   `json:"style"`
		Categories []string `json:"categories"`
		PreviewUrl string   `json:"preview_url"`
		SortOrder  int32    `json:"sort_order"`
		Status     int32    `json:"status"`
	}
	VoiceListReq {
		Category string `form:"category,optional"`
	}
	VoiceListResp {
		List []Voice `json:"list"`
	}
	SaveVoiceReq {
		Id         int64    `path:"id,optional"`
		Name       string   `json:"name"`
		Voice      string   `json:"voice"`
		Gender     string   `json:"gender,options=female|male"`
		Style      string   `json:"style,optional"`
		Categories []string `json:"categories,optional"`
		PreviewUrl string   `json:"preview_url,optional"`
		SortOrder  int32    `json:"sort_order,optional"`
		Status     int32    `json:"status,options=0|1"`
	}
	DigitalHumanListReq {
		UserId   int64 `form:"user_id,optional"`
		Status   int32 `form:"status,optional,default=-1"`
		Page     int64 `form:"page,optional,default=1"`
		PageSize int64 `form:"page_size,optional,default=20"`
	}
	DigitalHuman {
		Id             int64  `json:"id"`
		UserId         int64  `json:"user_id"`
		Name           string `json:"name"`
		PortraitSource string `json:"portrait_source"`
		ImageUrl       string `json:"image_url"`
		VoiceId        int64  `json:"voice_id"`
		VoiceName      string `json:"voice_name"`
		Script         string `json:"script"`
		VideoUrl       string `json:"video_url"`
		Duration       int32  `json:"duration"`
		Status         int32  `json:"status"`
		FailReason     string `json:"fail_reason"`
		CreateTime     int64  `json:"create_time"`
	}
	DigitalHumanListResp {
		List  []DigitalHuman `json:"list"`
		Total int64          `json:"total"`
	}
)

@server (
	prefix:     /api/v1/local-life/admin
	middleware: AdminAuth
	group:      digitalhuman
	tags:       "AI数字人"
	authType:   auth
)
service admin-api {
	@doc "数字人选项列表（年龄/肤色/职业/音色分类/提示词）"
	@handler listOptions
	get /digital-humans/options (DhOptionListReq) returns (OptionListResp)

	@doc "新增数字人选项"
	@handler createOption
	post /digital-humans/options (DhSaveOptionReq) returns (Option)

	@doc "编辑数字人选项"
	@handler updateOption
	put /digital-humans/options/:id (DhSaveOptionReq) returns (Option)

	@doc "删除数字人选项"
	@handler deleteOption
	delete /digital-humans/options/:id (IdPath) returns (EmptyResp)

	@doc "系统音色列表"
	@handler listVoices
	get /digital-humans/voices (VoiceListReq) returns (VoiceListResp)

	@doc "新增系统音色"
	@handler createVoice
	post /digital-humans/voices (SaveVoiceReq) returns (Voice)

	@doc "编辑系统音色"
	@handler updateVoice
	put /digital-humans/voices/:id (SaveVoiceReq) returns (Voice)

	@doc "删除系统音色"
	@handler deleteVoice
	delete /digital-humans/voices/:id (IdPath) returns (EmptyResp)

	@doc "生成试听：用该音色合成一句固定文案"
	@handler generateVoicePreview
	post /digital-humans/voices/:id/preview (IdPath) returns (Voice)

	@doc "当前配音模型（只读）"
	@handler getTTSModel
	get /digital-humans/tts-model returns (ModelResp)

	@doc "用户数字人列表"
	@handler list
	get /digital-humans (DigitalHumanListReq) returns (DigitalHumanListResp)
}

// ---------------- AI 图文笔记 ----------------
type (
	NoteListReq {
		UserId   int64 `form:"user_id,optional"`
		Status   int32 `form:"status,optional,default=-1"`
		Page     int64 `form:"page,optional,default=1"`
		PageSize int64 `form:"page_size,optional,default=20"`
	}
	Note {
		Id            int64    `json:"id"`
		UserId        int64    `json:"user_id"`
		NoteType      string   `json:"note_type"`
		NoteTypeLabel string   `json:"note_type_label"`
		Topic         string   `json:"topic"`
		Title         string   `json:"title"`
		Content       string   `json:"content"`
		Tags          []string `json:"tags"`
		ImageUrls     []string `json:"image_urls"`
		Status        int32    `json:"status"`
		FailReason    string   `json:"fail_reason"`
		CreateTime    int64    `json:"create_time"`
	}
	NoteListResp {
		List  []Note `json:"list"`
		Total int64  `json:"total"`
	}
)

@server (
	prefix:     /api/v1/local-life/admin
	middleware: AdminAuth
	group:      note
	tags:       "AI图文笔记"
	authType:   auth
)
service admin-api {
	@doc "用户图文笔记列表（只读，排查用）"
	@handler list
	get /notes (NoteListReq) returns (NoteListResp)
}

// ---------------- AI 海报 / AI 长图 ----------------
type (
	CreationListReq {
		UserId   int64  `form:"user_id,optional"`
		Kind     string `form:"kind,optional,options=|poster|longImage|actionTransfer|voiceover"`
		Media    string `form:"media,optional,options=|image|video"`
		Status   int32  `form:"status,optional,default=-1"`
		Page     int64  `form:"page,optional,default=1"`
		PageSize int64  `form:"page_size,optional,default=20"`
	}
	CreationItem {
		Id         int64    `json:"id"`
		UserId     int64    `json:"user_id"`
		Kind       string   `json:"kind"`
		Media      string   `json:"media"`
		Content    string   `json:"content"`
		ImageUrls  []string `json:"image_urls"`
		VideoUrl   string   `json:"video_url"`
		Status     int32    `json:"status"`
		FailReason string   `json:"fail_reason"`
		CreateTime int64    `json:"create_time"`
	}
	CreationListResp {
		List  []CreationItem `json:"list"`
		Total int64          `json:"total"`
	}
	GenOptionItem {
		Id        int64  `json:"id"`
		Group     string `json:"group"`
		Code      string `json:"code"`
		Label     string `json:"label"`
		SortOrder int32  `json:"sort_order"`
		Enabled   bool   `json:"enabled"`
		IsDefault bool   `json:"is_default"`
	}
	GenOptionListResp {
		List  []GenOptionItem `json:"list"`
		Kinds []GenKindItem   `json:"kinds"`
	}
	GenKindItem {
		Kind             string `json:"kind"`
		TemplateRequired bool   `json:"template_required"`
	}
	UpdateGenKindReq {
		Kind             string `path:"kind"`
		TemplateRequired bool   `json:"template_required"`
	}
	UpdateGenOptionReq {
		Id        int64  `path:"id"`
		Label     string `json:"label"`
		SortOrder int32  `json:"sort_order"`
		Enabled   bool   `json:"enabled"`
		IsDefault bool   `json:"is_default"`
	}
)

@server (
	prefix:     /api/v1/local-life/admin
	middleware: AdminAuth
	group:      imagegen
	tags:       "海报 / 长图 / 动作迁移 / 数字人口播"
	authType:   auth
)
service admin-api {
	@doc "用户海报/长图列表（只读，排查用）"
	@handler list
	get /creations (CreationListReq) returns (CreationListResp)

	@doc "用户探店视频/带货短剧列表（只读，排查用）"
	@handler listVideos
	get /video-creations (AdminVideoListReq) returns (AdminVideoListResp)
}

@server (
	prefix:     /api/v1/local-life/admin
	middleware: AdminAuth
	group:      genoption
	tags:       "生成配置"
	authType:   auth
)
service admin-api {
	@doc "生成选项列表（模型 / 比例 / 时长，含停用项）"
	@handler listGenOptions
	get /gen-options returns (GenOptionListResp)

	@doc "改生成选项：名称 / 启用 / 排序 / 默认（编码不可改；海报风格不可改名）"
	@handler updateGenOption
	put /gen-options/:id (UpdateGenOptionReq) returns (GenOptionItem)

	@doc "改生成类型的模板必选开关（海报 / 长图 / 动作迁移）"
	@handler updateGenKind
	put /gen-kinds/:kind (UpdateGenKindReq) returns (GenKindItem)
}

// ---------------- 探店视频 / 带货短剧（后台只读）----------------
type (
	AdminVideoListReq {
		UserId   int64  `form:"user_id,optional"`
		Kind     string `form:"kind,optional,options=|exploreShop|shortDrama|videoRemake"`
		Status   int32  `form:"status,optional,default=-1"`
		Page     int64  `form:"page,optional,default=1"`
		PageSize int64  `form:"page_size,optional,default=20"`
	}
	AdminVideoCreation {
		Id            int64  `json:"id"`
		UserId        int64  `json:"user_id"`
		Kind          string `json:"kind"`
		UserText      string `json:"user_text"`
		SellingPoints string `json:"selling_points"`
		Duration      int32  `json:"duration"`
		Size          string `json:"size"`
		Model         string `json:"model"`
		VideoUrl      string `json:"video_url"`
		Status        int32  `json:"status"`
		FailReason    string `json:"fail_reason"`
		CreateTime    int64  `json:"create_time"`
	}
	AdminVideoListResp {
		List  []AdminVideoCreation `json:"list"`
		Total int64                `json:"total"`
	}
)

// ---------------- 本地生活任务操作（由 Java 后台转发）----------------
type (
	RetryTaskReq {
		OriginRef string `path:"origin_ref"`
	}
	ForceFailTaskReq {
		OriginRef string `path:"origin_ref"`
	}
)

@server (
	prefix:     /api/v1/local-life/admin
	middleware: AdminAuth
	group:      localtask
	tags:       "本地生活任务操作"
	authType:   auth
)
service admin-api {
	@doc "运营重做生成失败的任务：origin_ref 形如 img:123（来源记录坐标）；按原内容重新冻结点数并重新提交"
	@handler retryTask
	post /tasks/:origin_ref/retry (RetryTaskReq) returns (EmptyResp)

	@doc "运营强制失败生成失败的任务：origin_ref 形如 img:123；封禁运营重做，点数已退回不动账"
	@handler forceFailTask
	post /tasks/:origin_ref/force-fail (ForceFailTaskReq) returns (EmptyResp)
}

// ---------------- studio 运营后台（/api/v1/studio/admin，nginx 单独转发到本后台）----------------
type (
	StudioListBatchesReq {
		Page     int64  `form:"page,optional,default=1"`
		PageSize int64  `form:"page_size,optional,default=20"`
		UserId   int64  `form:"user_id,optional"`
		Kind     string `form:"kind,optional,options=|tryon|pose|imagegen"`
		Status   int32  `form:"status,optional,default=-1"` // -1=全部；0-排队 1-切图中 2-反推中 3-生图中 4-全部成功 5-全部失败 6-部分成功 7-已取消 8-提交中
		StartAt  int64  `form:"start_at,optional"` // 创建时间起（unix 毫秒，含）
		EndAt    int64  `form:"end_at,optional"` // 创建时间止（unix 毫秒，不含）
	}
	StudioAdminBatch {
		Id              int64  `json:"id"`
		UserId          int64  `json:"user_id"`
		WorkspaceId     int64  `json:"workspace_id"`
		Kind            string `json:"kind"`
		Status          int32  `json:"status"`
		RequestId       string `json:"request_id"`
		Payload         string `json:"payload"` // JSON 文本
		TaskTotal       int32  `json:"task_total"`
		TaskDone        int32  `json:"task_done"`
		TaskFailed      int32  `json:"task_failed"`
		EstimatedPoints int64  `json:"estimated_points"`
		CostCny         string `json:"cost_cny"`
		ModelGroup      string `json:"model_group"`
		ErrorReason     string `json:"error_reason"`
		CoverUrl        string `json:"cover_url"`
		CreatedAt       int64  `json:"created_at"`
		UpdatedAt       int64  `json:"updated_at"`
	}
	StudioListBatchesResp {
		List  []StudioAdminBatch `json:"list"`
		Total int64              `json:"total"`
	}
	StudioAdminTask {
		Id               int64  `json:"id"`
		TaskId           string `json:"task_id"`
		ModelIndex       int32  `json:"model_index"`
		ShotIndex        int32  `json:"shot_index"`
		PoseIndex        int32  `json:"pose_index"`
		Status           int32  `json:"status"` // 0-排队 1-生成中 2-成功 3-失败 4-已取消 5-交付中
		ResultUrl        string `json:"result_url"`
		ResultWidth      int32  `json:"result_width"`
		ResultHeight     int32  `json:"result_height"`
		ErrorReason      string `json:"error_reason"`
		ModelGroup       string `json:"model_group"`
		PromptText       string `json:"prompt_text"` // 完整提示词
		PromptMeta       string `json:"prompt_meta"` // JSON 文本
		InputImages      string `json:"input_images"` // 送生图的图序（JSON 文本）
		GatewayCallId    string `json:"gateway_call_id"`
		GatewayStatus    string `json:"gateway_status"`
		Attempt          int32  `json:"attempt"`
		AdminLocked      bool   `json:"admin_locked"`
		CostCny          string `json:"cost_cny"`
		BillingRequestId string `json:"billing_request_id"`
		BillingStatus    int32  `json:"billing_status"` // 0-未计费 1-已冻结 2-已结算 3-已退回 4-影子模式
		DurationMs       int64  `json:"duration_ms"`
		CreatedAt        int64  `json:"created_at"`
		StartedAt        int64  `json:"started_at"`
		FinishedAt       int64  `json:"finished_at"`
	}
	StudioAdminBatchDetail {
		Batch          StudioAdminBatch  `json:"batch"`
		CropPlan       string            `json:"crop_plan"` // 切图框（JSON 文本，0–1 归一化）
		CropCheck      string            `json:"crop_check"` // 切图质检（JSON 文本）
		SelectedImages string            `json:"selected_images"` // 组图（JSON 文本）
		StepLog        string            `json:"step_log"` // 每步耗时与成本（JSON 文本）
		Tasks          []StudioAdminTask `json:"tasks"`
		Diagnostics    string            `json:"diagnostics"` // 排查视图（JSON 文本）：trace / workflowSteps / diagnosis / timeline
	}
	StudioTaskPath {
		TaskId string `path:"task_id"`
	}
	StudioDependency {
		Name      string `json:"name"` // sidecar / ai-gateway / media
		Ok        bool   `json:"ok"`
		BaseUrl   string `json:"base_url"`
		LatencyMs int64  `json:"latency_ms"`
		Version   string `json:"version"`
		Detail    string `json:"detail"`
	}
	StudioSidecarStatusResp {
		Deps          []StudioDependency `json:"deps"`
		RunningTasks  int32              `json:"running_tasks"`
		QueuedBatches int32              `json:"queued_batches"`
	}
	StudioCostSummaryReq {
		StartAt int64  `form:"start_at,optional"`
		EndAt   int64  `form:"end_at,optional"`
		GroupBy string `form:"group_by,optional,default=kind,options=kind|model_group"`
	}
	StudioCostRow {
		Key           string `json:"key"`
		TaskTotal     int32  `json:"task_total"`
		TaskSucceeded int32  `json:"task_succeeded"`
		TaskFailed    int32  `json:"task_failed"`
		CostCny       string `json:"cost_cny"`
		Points        int64  `json:"points"`
	}
	StudioCostSummaryResp {
		Rows  []StudioCostRow `json:"rows"`
		Total StudioCostRow   `json:"total"`
	}
)

@server (
	prefix:     /api/v1/studio/admin
	middleware: AdminAuth
	group:      studio
	tags:       "studio（商拍 / 姿态 / 图片生成）"
	authType:   auth
)
service admin-api {
	@doc "批次列表"
	@handler listBatches
	get /batches (StudioListBatchesReq) returns (StudioListBatchesResp)

	@doc "批次详情：切图框、组图、prompt、每步耗时与成本"
	@handler getBatch
	get /batches/:id (IdPath) returns (StudioAdminBatchDetail)

	@doc "重做失败的子任务（task_id 为子任务号）"
	@handler retryTask
	post /tasks/:task_id/retry (StudioTaskPath) returns (EmptyResp)

	@doc "强制失败子任务：封禁重做，点数已退回不动账"
	@handler forceFailTask
	post /tasks/:task_id/force-fail (StudioTaskPath) returns (EmptyResp)

	@doc "依赖状态：反推 sidecar / ai-gateway / 媒体服务"
	@handler sidecarStatus
	get /sidecar/status returns (StudioSidecarStatusResp)

	@doc "成本汇总（按类型或 model group）"
	@handler costSummary
	get /cost-summary (StudioCostSummaryReq) returns (StudioCostSummaryResp)
}

// ---------------- assetlib：资产库后台（/api/v1/asset-library/admin，权限 asset_library:view / update）----------------
type (
	AssetLibAdminTagsReq {
		Page     int64  `form:"page,optional,default=1"`
		PageSize int64  `form:"page_size,optional,default=20"`
		UserId   int64  `form:"user_id,optional"` // 0=全部用户
		Q        string `form:"q,optional"` // 标签名模糊
	}
	AssetLibAdminTag {
		Id         int64  `json:"id"`
		UserId     int64  `json:"user_id"`
		Name       string `json:"name"`
		AssetCount int64  `json:"asset_count"`
		CreatedAt  int64  `json:"created_at"`
	}
	AssetLibAdminTagsResp {
		List  []AssetLibAdminTag `json:"list"`
		Total int64              `json:"total"`
	}
	AssetLibKindStatsReq {
		UserId int64  `form:"user_id,optional"` // 0=全部用户
		Media  string `form:"media,optional,options=|image|video"`
	}
	AssetLibKindStat {
		Kind   string `json:"kind"` // 5 个 kind 或 uncategorized
		Source string `json:"source"` // upload / generated / official
		Count  int64  `json:"count"`
	}
	AssetLibCountItem {
		Key   string `json:"key"`
		Label string `json:"label"`
		Count int64  `json:"count"`
	}
	AssetLibKindStatsResp {
		Rows    []AssetLibKindStat  `json:"rows"` // kind × source
		Kinds   []AssetLibCountItem `json:"kinds"` // 按 kind 汇总（含 all）
		Sources []AssetLibCountItem `json:"sources"` // 按来源汇总
	}
)

@server (
	prefix:     /api/v1/asset-library/admin
	middleware: AdminAuth
	group:      assetlib
	tags:       "资产库"
	authType:   auth
)
service admin-api {
	@doc "标签字典（全部用户，分页）"
	@handler listTags
	get /tags (AssetLibAdminTagsReq) returns (AssetLibAdminTagsResp)

	@doc "分类统计：按 kind × 来源计数"
	@handler kindStats
	get /kind-stats (AssetLibKindStatsReq) returns (AssetLibKindStatsResp)
}

// ---------------- canvas：画布后台（/api/v1/canvas/admin，权限 canvas:view / update）----------------
type (
	CanvasAdminRunsReq {
		Page     int64  `form:"page,optional,default=1"`
		PageSize int64  `form:"page_size,optional,default=20"` // 上限 100
		UserId   int64  `form:"user_id,optional"`
		CanvasId string `form:"canvas_id,optional"`
		Kind     string `form:"kind,optional"` // image / video / tool_crop / tool_upscale / tool_outpaint / tool_inpaint / tool_i2p / tool_tryon
		Status   int32  `form:"status,optional,default=-1"` // -1 全部；0 排队 1 运行中 2 成功 3 失败 4 已取消 5 提交中
		Backend  string `form:"backend,optional"` // gateway / media / java / studio
		Start    int64  `form:"start,optional"` // unix 毫秒
		End      int64  `form:"end,optional"`
	}
	CanvasAdminRun {
		Id               int64    `json:"id"` // = request_id
		RunId            string   `json:"run_id"`
		TaskId           string   `json:"task_id"`
		UserId           int64    `json:"user_id"`
		CanvasId         string   `json:"canvas_id"`
		NodeId           string   `json:"node_id"`
		Kind             string   `json:"kind"`
		Status           string   `json:"status"`
		Progress         int32    `json:"progress"`
		Model            string   `json:"model"`
		ModelGroup       string   `json:"model_group"`
		Backend          string   `json:"backend"`
		BackendRef       string   `json:"backend_ref"` // gateway call_id（逗号分隔）/ Java taskUid / studio batch_id
		BillingRequestId string   `json:"billing_request_id"`
		BillingStatus    string   `json:"billing_status"` // none/held/settled/refunded/shadow/java/studio/review
		Credits          int64    `json:"credits"`
		CostCny          string   `json:"cost_cny"`
		Attempt          int32    `json:"attempt"`
		Candidates       []string `json:"candidates"`
		VideoUrl         string   `json:"video_url"`
		Text             string   `json:"text"`
		Error            string   `json:"error"`
		ErrorCode        string   `json:"error_code"`
		Request          string   `json:"request"` // RunNodeRequest JSON
		CreatedAt        int64    `json:"created_at"`
		StartedAt        int64    `json:"started_at"`
		FinishedAt       int64    `json:"finished_at"`
	}
	CanvasAdminRunsResp {
		List  []CanvasAdminRun `json:"list"`
		Total int64            `json:"total"`
	}
	CanvasAdminForceFailReq {
		Id     int64  `path:"id"`
		Reason string `json:"reason,optional"`
	}
	CanvasAdminCostReq {
		Start   int64  `form:"start,optional"`
		End     int64  `form:"end,optional"`
		GroupBy string `form:"group_by,optional,default=kind,options=kind|model_group"`
	}
	CanvasAdminCostRow {
		Key       string `json:"key"`
		Runs      int64  `json:"runs"`
		Succeeded int64  `json:"succeeded"`
		Failed    int64  `json:"failed"`
		Canceled  int64  `json:"canceled"`
		CostCny   string `json:"cost_cny"`
		Points    int64  `json:"points"`
	}
	CanvasAdminCostResp {
		Rows []CanvasAdminCostRow `json:"rows"`
	}
	CanvasAdminTemplatesReq {
		Page     int64  `form:"page,optional,default=1"`
		PageSize int64  `form:"page_size,optional,default=20"`
		Scope    string `form:"scope,optional,options=|official|user"`
		Enabled  int32  `form:"enabled,optional,default=-1"`
		Q        string `form:"q,optional"`
	}
	CanvasAdminTemplate {
		Id          int64  `json:"id"`
		Scope       string `json:"scope"`
		UserId      int64  `json:"user_id"`
		Title       string `json:"title"`
		Description string `json:"description"`
		CoverUrl    string `json:"cover_url"`
		Sort        int32  `json:"sort"`
		Enabled     bool   `json:"enabled"`
		NodeCount   int32  `json:"node_count"`
		EdgeCount   int32  `json:"edge_count"`
		Snapshot    string `json:"snapshot"` // JSON 文本 {nodes, edges}
		CreatedAt   int64  `json:"created_at"`
		UpdatedAt   int64  `json:"updated_at"`
	}
	CanvasAdminTemplatesResp {
		List  []CanvasAdminTemplate `json:"list"`
		Total int64                 `json:"total"`
	}
	CanvasAdminTemplateUpsertReq {
		Id          int64  `path:"id,optional"`
		Title       string `json:"title"`
		Description string `json:"description,optional"`
		Snapshot    string `json:"snapshot"` // JSON 文本 {nodes, edges}，按连线规则校验
		CoverUrl    string `json:"cover_url,optional"`
		Sort        int32  `json:"sort,optional"`
		Enabled     bool   `json:"enabled,optional"`
	}
	CanvasAdminToggleReq {
		Id      int64 `path:"id"`
		Enabled bool  `json:"enabled"`
	}
)

@server (
	prefix:     /api/v1/canvas/admin
	middleware: AdminAuth
	group:      canvas
	tags:       "画布"
	authType:   auth
)
service admin-api {
	@doc "节点执行（run）列表"
	@handler listRuns
	get /runs (CanvasAdminRunsReq) returns (CanvasAdminRunsResp)

	@doc "强制失败未结束的 run（gateway 后端退款并取消上游）"
	@handler forceFailRun
	post /runs/:id/force-fail (CanvasAdminForceFailReq) returns (EmptyResp)

	@doc "成本汇总（按 kind 或 model_group）"
	@handler costSummary
	get /cost-summary (CanvasAdminCostReq) returns (CanvasAdminCostResp)

	@doc "模板列表（官方 + 用户）"
	@handler listTemplates
	get /templates (CanvasAdminTemplatesReq) returns (CanvasAdminTemplatesResp)

	@doc "新增官方模板"
	@handler createTemplate
	post /templates (CanvasAdminTemplateUpsertReq) returns (CanvasAdminTemplate)

	@doc "编辑官方模板"
	@handler updateTemplate
	put /templates/:id (CanvasAdminTemplateUpsertReq) returns (CanvasAdminTemplate)

	@doc "模板上下架"
	@handler toggleTemplate
	post /templates/:id/toggle (CanvasAdminToggleReq) returns (EmptyResp)
}

// ---------------- promptlib：提示词库后台（/api/v1/prompt-library/admin，权限 canvas:view / update）----------------
type (
	PromptLibAdminListReq {
		Page     int64  `form:"page,optional,default=1"`
		PageSize int64  `form:"page_size,optional,default=20"`
		Scope    string `form:"scope,optional,default=official,options=official|user|all"`
		Vertical string `form:"vertical,optional"`
		Group    string `form:"group,optional"`
		Enabled  int32  `form:"enabled,optional,default=-1"`
		Q        string `form:"q,optional"`
	}
	PromptLibAdminItem {
		Id        int64    `json:"id"`
		UserId    int64    `json:"user_id"` // 0 = 官方
		Title     string   `json:"title"`
		Prompt    string   `json:"prompt"`
		Vertical  string   `json:"vertical"`
		Group     string   `json:"group"`
		Models    []string `json:"models"`
		Tags      []string `json:"tags"`
		Source    string   `json:"source"`
		Owner     string   `json:"owner"`
		Enabled   bool     `json:"enabled"`
		Sort      int32    `json:"sort"`
		CreatedAt int64    `json:"created_at"`
		UpdatedAt int64    `json:"updated_at"`
	}
	PromptLibAdminListResp {
		List  []PromptLibAdminItem `json:"list"`
		Total int64                `json:"total"`
	}
	PromptLibAdminUpsertReq {
		Id       int64    `path:"id,optional"`
		Title    string   `json:"title"`
		Prompt   string   `json:"prompt"`
		Vertical string   `json:"vertical,options=ecommerce|general"`
		Group    string   `json:"group"`
		Models   []string `json:"models,optional"`
		Tags     []string `json:"tags,optional"`
		Source   string   `json:"source,optional"`
		Sort     int32    `json:"sort,optional"`
		Enabled  bool     `json:"enabled,optional"`
	}
	PromptLibAdminToggleReq {
		Id      int64 `path:"id"`
		Enabled bool  `json:"enabled"`
	}
)

@server (
	prefix:     /api/v1/prompt-library/admin
	middleware: AdminAuth
	group:      promptlib
	tags:       "提示词库"
	authType:   auth
)
service admin-api {
	@doc "提示词列表（默认官方）"
	@handler listPrompts
	get /prompts (PromptLibAdminListReq) returns (PromptLibAdminListResp)

	@doc "新增官方提示词"
	@handler createPrompt
	post /prompts (PromptLibAdminUpsertReq) returns (PromptLibAdminItem)

	@doc "编辑官方提示词"
	@handler updatePrompt
	put /prompts/:id (PromptLibAdminUpsertReq) returns (PromptLibAdminItem)

	@doc "官方提示词启停"
	@handler togglePrompt
	post /prompts/:id/toggle (PromptLibAdminToggleReq) returns (EmptyResp)
}

