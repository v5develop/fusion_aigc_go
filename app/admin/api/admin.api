syntax = "v1"

info (
	title:   "AIGC 本地生活 运营后台网关"
	version: "v1"
)

type (
	IdPath {
		Id int64 `path:"id"`
	}
	EmptyResp  {}
	Option {
		Id         int64  `json:"id"`
		OptionType string `json:"option_type"`
		Code       string `json:"code"`
		Label      string `json:"label"`
		Value      string `json:"value"`
		SortOrder  int32  `json:"sort_order"`
		Status     int32  `json:"status"`
	}
	OptionListReq {
		OptionType string `form:"option_type,optional,options=CONTENT_TYPE|STYLE|INDUSTRY|WORD_COUNT|PROMPT|BLOCKWORD"`
	}
	OptionListResp {
		List []Option `json:"list"`
	}
	SaveOptionReq {
		Id         int64  `path:"id,optional"`
		OptionType string `json:"option_type,options=CONTENT_TYPE|STYLE|INDUSTRY|WORD_COUNT|PROMPT|BLOCKWORD"`
		Code       string `json:"code"`
		Label      string `json:"label"`
		Value      string `json:"value,optional"`
		SortOrder  int32  `json:"sort_order,optional"`
		Status     int32  `json:"status,options=0|1"`
	}
	ModelResp {
		Id       int64  `json:"id"`
		Name     string `json:"name"`
		Code     string `json:"code"`
		Platform string `json:"platform"`
	}
	CopywritingListReq {
		Page     int64  `form:"page,optional,default=1"`
		PageSize int64  `form:"page_size,optional,default=20"`
		UserId   int64  `form:"user_id,optional"`
		Keyword  string `form:"keyword,optional"`
	}
	Copywriting {
		Id               int64  `json:"id"`
		Source           string `json:"source"`
		ContentType      string `json:"content_type"`
		ContentTypeLabel string `json:"content_type_label"`
		Title            string `json:"title"`
		Body             string `json:"body"`
		WordCount        int32  `json:"word_count"`
		Status           int32  `json:"status"`
		FailReason       string `json:"fail_reason"`
		CreateTime       int64  `json:"create_time"`
	}
	CopywritingListResp {
		List  []Copywriting `json:"list"`
		Total int64         `json:"total"`
	}
)

@server (
	prefix:     /admin/v1
	middleware: AdminAuth
	group:      copywriting
)
service admin-api {
	@doc "选项列表"
	@handler listOptions
	get /copywriting/options (OptionListReq) returns (OptionListResp)

	@doc "新增选项"
	@handler createOption
	post /copywriting/options (SaveOptionReq) returns (Option)

	@doc "编辑选项"
	@handler updateOption
	put /copywriting/options/:id (SaveOptionReq) returns (Option)

	@doc "删除选项"
	@handler deleteOption
	delete /copywriting/options/:id (IdPath) returns (EmptyResp)

	@doc "当前写作模型（只读）"
	@handler getModel
	get /copywriting/model returns (ModelResp)

	@doc "用户文案列表"
	@handler listCopywriting
	get /copywriting (CopywritingListReq) returns (CopywritingListResp)

	@doc "删除用户文案"
	@handler deleteCopywriting
	delete /copywriting/:id (IdPath) returns (EmptyResp)
}

// ---------------- AI 数字人 ----------------
type (
	DhOptionListReq {
		OptionType string `form:"option_type,optional,options=AGE|SKIN_TONE|ROLE|VOICE_CATEGORY|PROMPT"`
	}
	DhSaveOptionReq {
		Id         int64  `path:"id,optional"`
		OptionType string `json:"option_type,options=AGE|SKIN_TONE|ROLE|VOICE_CATEGORY|PROMPT"`
		Code       string `json:"code"`
		Label      string `json:"label"`
		Value      string `json:"value,optional"`
		SortOrder  int32  `json:"sort_order,optional"`
		Status     int32  `json:"status,options=0|1"`
	}
	Voice {
		Id         int64    `json:"id"`
		Name       string   `json:"name"`
		Voice      string   `json:"voice"`
		Gender     string   `json:"gender"`
		Style      string   `json:"style"`
		Categories []string `json:"categories"`
		PreviewUrl string   `json:"preview_url"`
		SortOrder  int32    `json:"sort_order"`
		Status     int32    `json:"status"`
	}
	VoiceListReq {
		Category string `form:"category,optional"`
	}
	VoiceListResp {
		List []Voice `json:"list"`
	}
	SaveVoiceReq {
		Id         int64    `path:"id,optional"`
		Name       string   `json:"name"`
		Voice      string   `json:"voice"`
		Gender     string   `json:"gender,options=female|male"`
		Style      string   `json:"style,optional"`
		Categories []string `json:"categories,optional"`
		PreviewUrl string   `json:"preview_url,optional"`
		SortOrder  int32    `json:"sort_order,optional"`
		Status     int32    `json:"status,options=0|1"`
	}
	DigitalHumanListReq {
		UserId   int64 `form:"user_id,optional"`
		Status   int32 `form:"status,optional,default=-1"`
		Page     int64 `form:"page,optional,default=1"`
		PageSize int64 `form:"page_size,optional,default=20"`
	}
	DigitalHuman {
		Id             int64  `json:"id"`
		UserId         int64  `json:"user_id"`
		Name           string `json:"name"`
		PortraitSource string `json:"portrait_source"`
		ImageUrl       string `json:"image_url"`
		VoiceId        int64  `json:"voice_id"`
		VoiceName      string `json:"voice_name"`
		Script         string `json:"script"`
		VideoUrl       string `json:"video_url"`
		Duration       int32  `json:"duration"`
		Status         int32  `json:"status"`
		FailReason     string `json:"fail_reason"`
		CreateTime     int64  `json:"create_time"`
	}
	DigitalHumanListResp {
		List  []DigitalHuman `json:"list"`
		Total int64          `json:"total"`
	}
)

@server (
	prefix:     /admin/v1
	middleware: AdminAuth
	group:      digitalhuman
)
service admin-api {
	@doc "数字人选项列表（年龄/肤色/职业/音色分类/提示词）"
	@handler listOptions
	get /digital-humans/options (DhOptionListReq) returns (OptionListResp)

	@doc "新增数字人选项"
	@handler createOption
	post /digital-humans/options (DhSaveOptionReq) returns (Option)

	@doc "编辑数字人选项"
	@handler updateOption
	put /digital-humans/options/:id (DhSaveOptionReq) returns (Option)

	@doc "删除数字人选项"
	@handler deleteOption
	delete /digital-humans/options/:id (IdPath) returns (EmptyResp)

	@doc "系统音色列表"
	@handler listVoices
	get /digital-humans/voices (VoiceListReq) returns (VoiceListResp)

	@doc "新增系统音色"
	@handler createVoice
	post /digital-humans/voices (SaveVoiceReq) returns (Voice)

	@doc "编辑系统音色"
	@handler updateVoice
	put /digital-humans/voices/:id (SaveVoiceReq) returns (Voice)

	@doc "删除系统音色"
	@handler deleteVoice
	delete /digital-humans/voices/:id (IdPath) returns (EmptyResp)

	@doc "生成试听：用该音色合成一句固定文案"
	@handler generateVoicePreview
	post /digital-humans/voices/:id/preview (IdPath) returns (Voice)

	@doc "当前配音模型（只读）"
	@handler getTTSModel
	get /digital-humans/tts-model returns (ModelResp)

	@doc "用户数字人列表"
	@handler list
	get /digital-humans (DigitalHumanListReq) returns (DigitalHumanListResp)
}

